# Environment for takaoumehara.com. Copy to .env for local development
# (`npm run dev`); on Vercel set the same names in the project
# takaoumehara-com → Settings → Environment Variables. Never commit .env.
# All of these are read at request time by the on-demand routes; none is
# needed to build the site. See docs/admin.md.

# ── Admin (/admin) — Clerk ─────────────────────────────────────────────
# Both keys, or /admin shows "not configured" and /api/admin/* answers 503.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Who may use the admin: the account's primary, verified email must be listed.
# Comma-separated. Default when unset: takaoumehara@gmail.com
ADMIN_EMAILS=takaoumehara@gmail.com

# ── Admin saving — GitHub ──────────────────────────────────────────────
# Fine-grained personal access token limited to the repository below with
# "Contents: Read and write". Without it, saving offers a download instead.
GITHUB_TOKEN=
GITHUB_REPO=takaoumehara/takaoumehara.com
GITHUB_BRANCH=main

# ── Studio (/studio, /api/auth/*, /api/publish) — existing ─────────────
# See docs/adaptive-portfolio-architecture.md §16.7.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_SECRET=
# OWNER_LOGIN=
