---
// About intro block with portrait, name, positioning line, career summary, and links.
// Reused on home page and About page.
import { t, url } from "../../lib/html.mjs";

interface Props { lib: any; eager?: boolean }
const { lib, eager = false } = Astro.props;
const profile = lib.profile;
---

<section class="about-intro bento-cell">
  <div class="about-intro-grid">
    <figure class="about-intro-portrait">
      <picture>
        <source srcset="/assets/about/TakaoUmehara_passport.webp" type="image/webp" />
        <img src="/assets/about/TakaoUmehara_passport.png" alt={profile.name} width="512" height="512" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} decoding="async" />
      </picture>
    </figure>
    <div class="about-intro-copy">
      <h2 class="about-intro-name">{profile.name}</h2>
      <p class="about-intro-positioning">
        <span class="t-en">Principal Product Designer & AI Product Builder</span>
        <span class="t-jp" lang="ja">プリンシパル・プロダクトデザイナー／AI プロダクトビルダー</span>
      </p>
      <p class="about-intro-career">
        <span class="t-en">
          20+ years of 0→1 product, brand, and experience work. Verizon Lead Product Designer, AI Enablement (2025–2026), Concentrix Catalyst Lead Product Designer / Design Manager (2021–2023), ProjectEd (2015–2018), Amplify Education (2009–2015), founder of creativity is everywhere (2006–present). Designs and builds AI products and agent systems with Claude Code and Codex; Intent First is his venture.
        </span>
        <span class="t-jp" lang="ja">
          0→1 プロダクト、ブランド、エクスペリエンスデザインで 20 年以上。Verizon Lead Product Designer（AI Enablement、2025–2026）、Concentrix Catalyst Lead Product Designer / Design Manager（2021–2023）、ProjectEd（2015–2018）、Amplify Education（2009–2015）、creativity is everywhere 創業（2006–現在）。Claude Code や Codex で AI プロダクトとエージェント・システムを構築。Intent First がそのベンチャー。
        </span>
      </p>
      <div class="about-intro-actions">
        <a href="/takao-umehara-resume.pdf" class="about-intro-btn" download>
          <span class="t-en">Resume (PDF)</span>
          <span class="t-jp" lang="ja">履歴書 (PDF)</span>
        </a>
        <a href={profile.contact.linkedin} target="_blank" rel="noopener" class="about-intro-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
          </svg>
          <span class="t-en">LinkedIn</span>
          <span class="t-jp" lang="ja">LinkedIn</span>
        </a>
        <a href="/about#work-with-me" class="about-intro-btn">
          <span class="t-en">Contact</span>
          <span class="t-jp" lang="ja">相談</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-intro {
    padding: var(--cell-pad);
  }

  .about-intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--sp-6);
    align-items: start;
  }

  .about-intro-portrait {
    margin: 0;
    padding: 0;
    border-radius: var(--r);
    overflow: hidden;
    aspect-ratio: 1;
  }

  .about-intro-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-intro-name {
    margin: 0 0 var(--sp-2) 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--pr-ink);
  }

  .about-intro-positioning {
    margin: 0 0 var(--sp-4) 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--pr-tint);
  }

  .about-intro-career {
    margin: 0 0 var(--sp-5) 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--pr-ink);
  }

  .about-intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }

  .about-intro-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: var(--sp-2) var(--sp-3);
    background: var(--pr-card);
    color: var(--pr-ink);
    text-decoration: none;
    border-radius: var(--r-pill);
    font-size: var(--text-body);
    font-weight: 500;
    transition: background 140ms ease, color 140ms ease;
  }

  .about-intro-btn:hover {
    background: var(--pr-card-2);
    color: var(--pr-ink);
  }

  .about-intro-btn:focus-visible {
    outline: 2px solid var(--pr-blue);
    outline-offset: 2px;
  }

  .about-intro-btn svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 768px) {
    .about-intro {
      padding: var(--cell-pad);
    }

    .about-intro-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }

    .about-intro-portrait {
      max-width: 280px;
    }
  }
</style>
