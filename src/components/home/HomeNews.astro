---
// The home page's news bento, under the hero: the basic-info card first, then
// one article per interactive launch or open tool release (src/data/news.mjs),
// newest first. Interactive entries link to their detail page; tool entries
// link to their own href (docs or repo, opened in a new tab). Cards
// sit on --gap-grid, 3 / 2 / 1 columns like the work grid below, separated by
// fill and whitespace only.
import "../../styles/home.css";
import { t, tb, url } from "../../lib/html.mjs";
import { destination } from "../../lib/site.mjs";

interface Props { lib: any; news: any[] }
const { lib, news } = Astro.props;
const profile = lib.profile;

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const dateLabel = (iso) => {
  const [y, m, d] = iso.split("-").map(Number);
  return { en: `${MONTHS[m - 1]} ${d}, ${y}`, jp: `${y}年${m}月${d}日` };
};

const META = {
  experiment: { en: "Interactive", jp: "インタラクティブ" },
  tool: { en: "Open tool", jp: "オープンツール" },
  thesis: { en: "Thesis", jp: "論考" },
};

const articles = [...news]
  .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0))
  .map((entry) => {
    const kind = entry.kind ?? "experiment";
    const item = entry.slug ? lib.evidence.get(entry.slug) : null;
    const assets = item?.assets ?? {};
    const art = {
      image: entry.image ?? assets.thumb ?? assets.hero ?? null,
      art: entry.art ?? assets.art ?? "card-art--motion",
      artLabel: entry.artLabel ?? assets.artLabel ?? item?.title ?? "",
      meta: entry.meta ?? META[kind] ?? META.experiment,
    };
    if (kind === "tool") {
      if (!entry.href) return null;
      return { ...entry, ...art, external: /^https?:/i.test(entry.href) };
    }
    if (!item) return null;
    const to = destination(item);
    return { ...entry, ...art, href: to && !to.external ? to.url : null, external: false };
  })
  .filter((a) => a && a.href);

const links = [
  { href: "/about", label: { en: "About", jp: "プロフィール" } },
  { href: "/contact", label: { en: "Contact", jp: "お問い合わせ" } },
  { href: "/ai-tools.html", label: { en: "Open tools", jp: "オープンツール" } },
  profile.contact?.linkedin && { href: profile.contact.linkedin, label: { en: "LinkedIn", jp: "LinkedIn" }, external: true },
  profile.contact?.github && { href: profile.contact.github, label: { en: "GitHub", jp: "GitHub" }, external: true },
].filter(Boolean);
---
<section class="home-news" aria-labelledby="home-news-title">
  <h2 class="sr-only" id="home-news-title"><span class="t-en">About Takao and recent releases</span><span class="t-jp">プロフィールと最近の公開作</span></h2>
  <div class="hn-grid">
    <article class="hn-card hn-info bento-cell">
      <p class="hn-kicker"><span set:html={t(profile.location)} /></p>
      <h3 class="hn-name">{profile.name}</h3>
      <p class="hn-tagline" set:html={t(profile.tagline)} />
      <p class="grid-headline" set:html={tb(profile.positioning[1])} />
      <ul class="hn-links">
        {links.map((l) => (
          <li>
            <a href={l.href} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener" : undefined}>
              <span set:html={t(l.label)} /><span aria-hidden="true">{l.external ? "↗" : "→"}</span>
            </a>
          </li>
        ))}
      </ul>
    </article>

    {articles.map((a, i) => {
      const d = dateLabel(a.date);
      return (
        <article class="hn-card hn-article bento-cell" style={`--i: ${i}`}>
          <p class="hn-meta">
            <span set:html={t(a.meta)} />
            <span aria-hidden="true"> · </span>
            <time datetime={a.date} set:html={t(d)} />
          </p>
          <h3 class="hn-title">
            <a class="hn-link" href={a.href} target={a.external ? "_blank" : undefined} rel={a.external ? "noopener" : undefined} set:html={t(a.title)} />
          </h3>
          <p class="hn-lead" set:html={tb(a.lead)} />
          <div class="hn-thumb">
            {a.image
              ? <img src={url(a.image)} alt="" loading="lazy" decoding="async" />
              : <div class={`card-art ${a.art}`}><span class="card-art-label">{a.artLabel}</span></div>}
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  /* Every card here is a bento cell (docs/superforge.md's shared bento rule):
     the same inner padding as every other cell in the right pane, so this
     card's text lines up with the work grid's and the detail page's. Astro
     scopes this selector with a data-astro-cid attribute, which outranks the
     plain .hn-card rule in src/styles/home.css (B's file) without editing it. */
  .hn-card {
    padding: var(--cell-pad, clamp(20px, 3vw, 32px));
  }
</style>
