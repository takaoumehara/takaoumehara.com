---
// The home page's right pane, shared by src/pages/index.astro and the
// Japanese edition src/pages/ja/index.astro (only lang and canonical differ):
// the About block (portrait, career summary, Resume / LinkedIn / Contact),
// Now, the big showcase slideshow (Porto Rocha size), then "Updates" over the
// news bento. "Work" — the filter pills and the full grid — is /work.
import AboutIntro from "./AboutIntro.astro";
import HomeNow from "./HomeNow.astro";
import HomeHero from "./HomeHero.astro";
import HomeNews from "./HomeNews.astro";
import { NEWS, SHOWCASE } from "../../data/news.mjs";

interface Props { lib: any }
const { lib } = Astro.props;
---
<main class="cat-page grid-home" data-category="home">
  <AboutIntro lib={lib} eager={true} />
  <HomeNow lib={lib} />
  <HomeHero lib={lib} order={SHOWCASE} />
  <h2 class="home-updates-heading">
    <span class="t-en">Updates</span>
    <span class="t-jp" lang="ja">最近の更新</span>
  </h2>
  <HomeNews lib={lib} news={NEWS} />
</main>

<style>
  .home-updates-heading {
    margin: 0;
    padding: var(--cell-pad);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }
</style>
