---
// The left rail, a precision directory of the work: controls (all work ·
// search · theme · language), the wordmark over a system index (how many
// works, how many disciplines, the advisory status), an About card, then every
// piece of work grouped by category (src/categories/*.json) as rows with a
// 64px tile or a mono tag badge.
//
// Site.astro persists this element across client-side navigations
// (transition:persist), so aria-current is computed twice: here for the
// built HTML and again in src/scripts/site.js after every swap, from the
// data-match paths each link carries.
import { getLibrary, orderedCategories, destination, samePage } from "../lib/site.mjs";
import { t, tb, esc, url } from "../lib/html.mjs";

interface Props { current?: string }
const { current = Astro.url.pathname } = Astro.props;

const lib = getLibrary();
const profile = lib.profile;
const categories = orderedCategories();

// Person pages consolidated into /about
// Work archive is no longer in sidebar per IA redesign

const matches = (page) => page.match ?? [page.href];
const isCurrent = (page) => matches(page).some((p) => samePage(p, current));
const cur = (hit) => (hit ? "page" : undefined);

const groups = categories.map((category) => {
  const items = category.groups.flatMap((g) => g.items).map((id) => lib.evidence.get(id)).filter(Boolean)
    .map((item) => {
      const to = destination(item);
      const href = to ? to.url : `/${category.output}#${item.slug}`;
      const here = to && !to.external && samePage(to.url, current);
      return { item, to, href, here };
    });
  return { category, items };
});

// The rail head's system index: how many distinct pieces of work the rail
// lists (a piece filed under two categories counts once) and in how many
// disciplines. Both come from the same data as the rows, never hardcoded.
const workCount = new Set(groups.flatMap(({ items }) => items.map(({ item }) => item.id ?? item.slug))).size;
const disciplineCount = groups.length;

// First-load boot order (src/styles/transitions.css): every category head and
// row gets its place in the rail, top to bottom, so the stagger runs down the
// whole directory rather than restarting in each group. Only the first ones
// animate; the rest are simply there.
const BOOT_ROWS = 12;
let bootIndex = 0;
const bootGroups = groups.map((g) => ({ ...g, head: bootIndex++, rows: g.items.map(() => bootIndex++) }));
const rowStyle = (i) => (i < BOOT_ROWS ? `--row-i: ${i}` : undefined);

// A count that rolls up on the first load: the real number is the element's
// text (what a screen reader reads), and the rolling copy is a decoration
// drawn over it by CSS from --to.
const odo = (n) => `<span class="odo" style="--to: ${Number(n) || 0}">${Number(n) || 0}</span>`;

// A row is named, not described: the Latin short name in both languages.
// Resona stays "Resona" in the Japanese edition, the way a studio site keeps
// its project names — the Japanese lives in the one-liner underneath.
const name = (item) => esc(item.shortTitle ?? item.title);

// A row with no image gets initials on a coloured square, not an icon and not a
// wordmark squeezed into 9px: one letter for a one-word name ("Moime" → M), two
// otherwise ("Kao Game" → KG). With three or more words it takes the first and
// the last meaningful one ("Verizon AI Workflow" → VW), skipping the small
// connecting words so "Museum of the Future" reads MF rather than MO.
const SMALL_WORDS = new Set(["a", "an", "the", "of", "for", "and", "or", "to", "in", "on", "at", "with", "by", "from", "x", "vs"]);
const initials = (title) => {
  const words = String(title).replace(/[^\p{L}\p{N}\s-]/gu, " ").split(/[\s\-—–]+/u).filter(Boolean);
  if (!words.length) return "?";
  if (words.length === 1) return words[0].slice(0, 1).toUpperCase();
  const meaningful = words.filter((w) => !SMALL_WORDS.has(w.toLowerCase()));
  const pick = meaningful.length >= 2 ? meaningful : words;
  if (pick.length === 1) return pick[0].slice(0, 1).toUpperCase();
  const last = pick.length > 2 ? pick[pick.length - 1] : pick[1];
  return (pick[0].slice(0, 1) + last.slice(0, 1)).toUpperCase();
};

// Deterministic hue, so a project keeps its colour across builds and pages.
const hue = (seed) => {
  let h = 0;
  for (const ch of String(seed)) h = (Math.imul(h, 31) + ch.codePointAt(0)) >>> 0;
  return h % 360;
};

// No image: a tag badge — the initials in mono inside a 1px frame, with the
// project's deterministic hue kept only as a small tag mark in the corner.
const thumb = (item) => {
  const image = item.assets?.thumb ?? item.assets?.hero;
  if (image) return `<img src="${esc(url(image))}" alt="" loading="lazy" width="64" height="64">`;
  const label = initials(item.shortTitle ?? item.title);
  return `<span class="side-initials" style="--initials-h: ${hue(item.slug ?? label)}" aria-hidden="true">${esc(label)}</span>`;
};
---
<aside class="side" id="side" transition:persist="side">
  <script is:inline>
    // Set here, at the top of <body>, before the rail or the pane is painted.
    //  - html[data-boot], on the first load of the session only, turns on the
    //    rail's boot sequence (src/styles/transitions.css): every boot
    //    animation fills backwards and ends on the element's own styles.
    //  - html[data-mo-intro] ("boot" or "reload"), on every full load, keeps
    //    the right pane transparent until src/scripts/motion.js has laid its
    //    boxes down and started filling them in; motion.js removes it. If that
    //    script never runs, the timeout below shows the pane anyway.
    // Reduced motion sets neither.
    (function () {
      if (window.__tuBoot) return;
      window.__tuBoot = true;
      var html = document.documentElement;
      var first = false;
      try {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        first = !sessionStorage.getItem("tu-booted");
        if (first) sessionStorage.setItem("tu-booted", "1");
      } catch (e) { return; }
      if (first) html.setAttribute("data-boot", "");
      html.setAttribute("data-mo-intro", first ? "boot" : "reload");
      setTimeout(function () { html.removeAttribute("data-mo-intro"); }, 2500);
    })();
  </script>
  <div class="side-top">
    <a class="side-wordmark" href="/">{profile.name}</a>
    <span class="side-top-status"><span class="side-dot" aria-hidden="true"></span><span class="t-en">Open for 0→1</span><span class="t-jp">0→1 受付中</span></span>
    <button class="side-toggle" id="side-toggle" type="button" aria-expanded="false" aria-controls="side-panel">Menu</button>
  </div>

  <div class="side-panel" id="side-panel">
    <div class="side-controls">
      <div class="side-controls-left">
        <a class="side-all" href="/work" data-match="/work /work.html" aria-current={cur(samePage("/work", current))}>
          <span class="t-en">All work</span><span class="t-jp">すべての作品</span>
        </a>
        <button class="side-search-toggle" id="side-search-toggle" type="button" aria-label="Search" title="Search">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="8" cy="8" r="6"/>
            <path d="M13 13l5 5"/>
          </svg>
        </button>
      </div>
      <div class="side-ctl">
        <button class="side-theme" id="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark mode"></button>
        <button class="side-lang" id="lang-cycle" type="button" aria-label="Switch to Japanese">JP</button>
      </div>
    </div>
    
    <div class="side-search" id="side-search" hidden>
      <input 
        type="search" 
        class="side-search-input" 
        id="side-search-input"
        placeholder="Search…"
        data-placeholder-en="Search…"
        data-placeholder-jp="検索…"
      />
    </div>

    <div class="side-head">
      <a class="side-wordmark" href="/" data-match="/" aria-current={cur(samePage("/", current))}>{profile.name}</a>
      <dl class="side-status">
        <div class="side-index">
          <dt class="vh"><span class="t-en">Index</span><span class="t-jp">索引</span></dt>
          <dd>
            <span class="t-en"><Fragment set:html={odo(workCount)} /> Selected Works</span><span class="t-jp">厳選 <Fragment set:html={odo(workCount)} /> 作品</span>
            <span class="side-sep" aria-hidden="true">·</span>
            <span class="t-en"><Fragment set:html={odo(disciplineCount)} /> Disciplines</span><span class="t-jp"><Fragment set:html={odo(disciplineCount)} /> 領域</span>
          </dd>
        </div>
        <div class="side-avail">
          <dt class="vh"><span class="t-en">Status</span><span class="t-jp">ステータス</span></dt>
          <dd><span class="side-dot" aria-hidden="true"></span><span class="side-avail-text"><span class="t-en">Available for 0→1 Advisory</span><span class="t-jp">0→1 アドバイザリー受付中</span></span></dd>
        </div>
      </dl>
    </div>

    <section class="side-about">
      <a class="side-label" href="/about" data-match="/about /about.html" aria-current={cur(samePage("/about", current))}>
        <span class="t-en">About</span><span class="t-jp">について</span>
      </a>
      <p set:html={tb(profile.positioning[1])} />
    </section>

    <nav class="side-work" aria-label="Work by category">
      {bootGroups.map(({ category, items, head, rows }) => (
        <details class="side-group" open>
          <summary style={rowStyle(head)} data-boot-row={head < BOOT_ROWS ? "" : undefined}>
            <span class="side-group-title" set:html={t(category.title)} />
            <span class="side-count" set:html={odo(items.length)} />
          </summary>
          <ul>
            {items.map(({ item, to, href, here }, i) => (
              <li>
                <a class="side-item" href={href} style={rowStyle(rows[i])} data-boot-row={rows[i] < BOOT_ROWS ? "" : undefined}
                   data-match={to?.external ? undefined : href}
                   aria-current={cur(here)}
                   target={to?.external ? "_blank" : undefined} rel={to?.external ? "noopener" : undefined}>
                  <span class="side-thumb" set:html={thumb(item)} />
                  <span class="side-text">
                    <span class="side-name" set:html={name(item)} />
                    <span class="side-line" set:html={t(item.cardLine ?? item.summary)} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </nav>

    <p class="side-foot"><span set:html={t(profile.location)} /> · <a href={profile.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a></p>
  </div>
</aside>
