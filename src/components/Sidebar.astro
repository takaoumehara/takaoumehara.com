---
// The left rail, a precision directory of the work: controls (all work ·
// search · theme · language), the wordmark over a system index (how many
// works, how many disciplines, the "Open to full-time" status), an About card, then every
// piece of work grouped by category (src/categories/*.json) as rows with a
// 64px tile or a mono tag badge.
//
// Site.astro persists this element across client-side navigations
// (transition:persist), so aria-current is computed twice: here for the
// built HTML and again in src/scripts/site.js after every swap, from the
// data-match paths each link carries.
import { getLibrary, orderedCategories, destination, samePage } from "../lib/site.mjs";
import { t, tb, esc, url } from "../lib/html.mjs";
import MOTION from "../data/motion.json";

interface Props { current?: string }
const { current = Astro.url.pathname } = Astro.props;

const lib = getLibrary();
const profile = lib.profile;
const categories = orderedCategories();

// Person pages consolidated into /about
// Work archive is no longer in sidebar per IA redesign

const matches = (page) => page.match ?? [page.href];
const isCurrent = (page) => matches(page).some((p) => samePage(p, current));
const cur = (hit) => (hit ? "page" : undefined);

const groups = categories.map((category) => {
  const items = category.groups.flatMap((g) => g.items).map((id) => lib.evidence.get(id)).filter(Boolean)
    .map((item) => {
      const to = destination(item);
      const href = to ? to.url : `/${category.output}#${item.slug}`;
      const here = to && !to.external && samePage(to.url, current);
      return { item, to, href, here };
    });
  // Auto-open category if it's the current page or contains the current item
  const isCategoryPage = samePage(`/${category.output}`, current);
  const containsCurrentItem = items.some(({ here }) => here);
  const shouldOpen = isCategoryPage || containsCurrentItem;
  return { category, items, shouldOpen };
});
// The accordion is exclusive: at most one category starts open (the first
// that matches this page).
const firstOpen = groups.findIndex(({ shouldOpen }) => shouldOpen);
groups.forEach((g, i) => { g.shouldOpen = i === firstOpen; });

// The rail head's system index: how many distinct pieces of work the rail
// lists (a piece filed under two categories counts once) and in how many
// disciplines. Both come from the same data as the rows, never hardcoded.
const workCount = new Set(groups.flatMap(({ items }) => items.map(({ item }) => item.id ?? item.slug))).size;
const disciplineCount = groups.length;

// A count: mono, tabular (shell.css). On the first load its digits are typed
// as random digits before they settle, like the rest of the rail's type
// (src/scripts/motion.js).
const odo = (n) => `<span class="odo">${Number(n) || 0}</span>`;

// What the inline script below needs from the motion config to decide, before
// the first paint, whether the rail and the pane will play their loading
// sequence (src/data/motion.json; the Motion Lab's working copy overrides it
// while the lab is open in the tab).
const moGate = { enabled: MOTION.global.enabled, runOn: MOTION.global.runOn, railPlayOn: MOTION.rail.playOn };

// A row is named, not described: the Latin short name in both languages.
// Resona stays "Resona" in the Japanese edition, the way a studio site keeps
// its project names — the Japanese lives in the one-liner underneath.
const name = (item) => esc(item.shortTitle ?? item.title);

// A row with no image gets initials on a coloured square, not an icon and not a
// wordmark squeezed into 9px: one letter for a one-word name ("Moime" → M), two
// otherwise ("Kao Game" → KG). With three or more words it takes the first and
// the last meaningful one ("Verizon AI Workflow" → VW), skipping the small
// connecting words so "Museum of the Future" reads MF rather than MO.
const SMALL_WORDS = new Set(["a", "an", "the", "of", "for", "and", "or", "to", "in", "on", "at", "with", "by", "from", "x", "vs"]);
const initials = (title) => {
  const words = String(title).replace(/[^\p{L}\p{N}\s-]/gu, " ").split(/[\s\-—–]+/u).filter(Boolean);
  if (!words.length) return "?";
  if (words.length === 1) return words[0].slice(0, 1).toUpperCase();
  const meaningful = words.filter((w) => !SMALL_WORDS.has(w.toLowerCase()));
  const pick = meaningful.length >= 2 ? meaningful : words;
  if (pick.length === 1) return pick[0].slice(0, 1).toUpperCase();
  const last = pick.length > 2 ? pick[pick.length - 1] : pick[1];
  return (pick[0].slice(0, 1) + last.slice(0, 1)).toUpperCase();
};

// Deterministic hue, so a project keeps its colour across builds and pages.
const hue = (seed) => {
  let h = 0;
  for (const ch of String(seed)) h = (Math.imul(h, 31) + ch.codePointAt(0)) >>> 0;
  return h % 360;
};

// No image: a tag badge — the initials in mono inside a 1px frame, with the
// project's deterministic hue kept only as a small tag mark in the corner.
// assets.railThumb, when a record carries one, is a small pre-cut square for
// this 64-84px slot, so the rail (on every page) never pulls a full-size still.
const thumb = (item) => {
  const image = item.assets?.railThumb ?? item.assets?.thumb ?? item.assets?.hero;
  if (image) return `<img src="${esc(url(image))}" alt="" loading="lazy" width="64" height="64">`;
  const label = initials(item.shortTitle ?? item.title);
  return `<span class="side-initials" style="--initials-h: ${hue(item.slug ?? label)}" aria-hidden="true">${esc(label)}</span>`;
};
---
<aside class="side" id="side" transition:persist="side">
  <script is:inline define:vars={{ moGate }}>
    // Set here, at the top of <body>, before the rail or the pane is painted:
    //  - html[data-mo-intro] when the right pane will play its loading
    //    sequence on this full load (global.runOn is first-load or both);
    //  - html[data-mo-rail] when the rail will (rail.playOn: session-first =
    //    the first full load of the tab's session, every-load, always).
    // CSS keeps those surfaces transparent until src/scripts/motion.js has
    // laid its first frames down and removes the attributes; if that script
    // never runs, the timeout below shows everything anyway. ?lab=1 opens
    // the Motion Lab for the tab (?lab=0 closes it); while it is open its
    // working config (localStorage "tu-motion-lab") overrides the defaults.
    // Reduced motion sets neither attribute.
    (function () {
      if (window.__tuBoot) return;
      window.__tuBoot = true;
      var html = document.documentElement;
      var gate = { enabled: moGate.enabled, runOn: moGate.runOn, railPlayOn: moGate.railPlayOn };
      var first = false;
      try {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var q = new URLSearchParams(location.search).get("lab");
        if (q === "1") sessionStorage.setItem("tu-lab", "1");
        if (q === "0") sessionStorage.removeItem("tu-lab");
        if (sessionStorage.getItem("tu-lab") === "1") {
          var lab = JSON.parse(localStorage.getItem("tu-motion-lab") || "null");
          if (lab && lab.global) {
            if (typeof lab.global.enabled === "boolean") gate.enabled = lab.global.enabled;
            if (lab.global.runOn) gate.runOn = lab.global.runOn;
          }
          if (lab && lab.rail && lab.rail.playOn) gate.railPlayOn = lab.rail.playOn;
        }
        first = !sessionStorage.getItem("tu-booted");
        if (first) sessionStorage.setItem("tu-booted", "1");
      } catch (e) { return; }
      if (!gate.enabled) return;
      var pane = gate.runOn === "first-load" || gate.runOn === "both";
      var rail = gate.railPlayOn === "every-load" || gate.railPlayOn === "always" || (gate.railPlayOn === "session-first" && first);
      if (pane) html.setAttribute("data-mo-intro", "");
      if (rail) html.setAttribute("data-mo-rail", "");
      if (pane || rail) setTimeout(function () { html.removeAttribute("data-mo-intro"); html.removeAttribute("data-mo-rail"); }, 3000);
    })();
  </script>
  <div class="side-top">
    <a class="side-wordmark" href="/">{profile.name}</a>
    <button class="side-toggle" id="side-toggle" type="button" aria-expanded="false" aria-controls="side-panel">Menu</button>
    <p class="side-top-status"><span class="side-dot" aria-hidden="true"></span><span class="t-en">Open to full-time · Staff/Principal Product Designer & AI roles</span><span class="t-jp" lang="ja">フルタイム募集中・Staff/Principal プロダクトデザイナー／AI 職</span></p>
  </div>

  <div class="side-panel" id="side-panel">
    <div class="side-controls">
      <div class="side-controls-left">
        <a class="side-all" href="/work" data-match="/work /work.html" aria-current={cur(samePage("/work", current))}>
          <span class="t-en">Work</span><span class="t-jp" lang="ja">作品</span>
        </a>
        <button class="side-search-toggle" id="side-search-toggle" type="button" aria-label="Search" title="Search">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="8" cy="8" r="6"/>
            <path d="M13 13l5 5"/>
          </svg>
        </button>
      </div>
      <div class="side-ctl">
        <button class="side-theme" id="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark mode"></button>
        <button class="side-lang" id="lang-cycle" type="button" aria-label="Switch to Japanese">JP</button>
      </div>
    </div>

    <div class="side-search" id="side-search" hidden>
      <input 
        type="search" 
        class="side-search-input" 
        id="side-search-input"
        placeholder="Search…"
        data-placeholder-en="Search…"
        data-placeholder-jp="検索…"
      />
    </div>

    <div class="side-head">
      <a class="side-wordmark" href="/" data-match="/" aria-current={cur(samePage("/", current))}>{profile.name}</a>
      <dl class="side-status">
        <div class="side-index">
          <dt class="vh"><span class="t-en">Index</span><span class="t-jp" lang="ja">索引</span></dt>
          <dd>
            <span class="t-en"><Fragment set:html={odo(workCount)} /> Selected Works</span><span class="t-jp" lang="ja">厳選 <Fragment set:html={odo(workCount)} /> 作品</span>
            <span class="side-sep" aria-hidden="true">·</span>
            <span class="t-en"><Fragment set:html={odo(disciplineCount)} /> Disciplines</span><span class="t-jp" lang="ja"><Fragment set:html={odo(disciplineCount)} /> 領域</span>
          </dd>
        </div>
        <div class="side-avail">
          <dt class="vh"><span class="t-en">Status</span><span class="t-jp" lang="ja">ステータス</span></dt>
          <dd><span class="side-dot" aria-hidden="true"></span><span class="side-avail-text"><span class="t-en">Open to full-time · Staff/Principal Product Designer & AI roles</span><span class="t-jp" lang="ja">フルタイム募集中・Staff/Principal プロダクトデザイナー／AI 職</span></span></dd>
        </div>
      </dl>
    </div>

    {/* Site links (About · Work · Contact · Resume · LinkedIn): one compact
        line under the wordmark on desktop; in the mobile menu (the same panel)
        each link gets a 44px-tall hit area (shell.css .side-nav). The
        wordmark above is the Home link. */}
    <nav class="side-nav" aria-label="Site">
      <a class="side-nav-link" href="/about" data-match="/about /about.html" aria-current={cur(samePage("/about", current))}>
        <span class="t-en">About</span><span class="t-jp" lang="ja">について</span>
      </a>
      <a class="side-nav-link" href="/work" data-match="/work /work.html" aria-current={cur(samePage("/work", current))}>
        <span class="t-en">Work</span><span class="t-jp" lang="ja">作品</span>
      </a>
      <a class="side-nav-link" href="/about#work-with-me">
        <span class="t-en">Contact</span><span class="t-jp" lang="ja">相談</span>
      </a>
      <a class="side-nav-link" href="/takao-umehara-resume.pdf" target="_blank" rel="noopener">
        <span class="t-en">Resume (PDF)</span><span class="t-jp" lang="ja">履歴書 (PDF)</span>
      </a>
      <a class="side-nav-link" href={profile.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </nav>

    {/* The whole card is the link to /about: the label is the one link (one
        tab stop, its name "About"), and its ::after stretches over the card
        (shell.css), so the positioning line underneath is still read as a
        paragraph and nothing interactive is nested. */}
    <section class="side-about">
      <a class="side-label" href="/about" data-match="/about /about.html" aria-current={cur(samePage("/about", current))}>
        <span class="t-en">About</span><span class="t-jp" lang="ja">について</span>
      </a>
      <p set:html={tb(profile.positioning[1])} />
    </section>

    <nav class="side-work" aria-label="Work by category">
      {groups.map(({ category, items, shouldOpen }, idx) => {
        const slugs = items.map(({ item }) => item.slug).filter(Boolean);
        return (
          <div class="side-group" id={`side-group-${category.slug}`} data-cat={category.slug} data-cat-index={idx} data-slugs={slugs.join(",")}>
            <button
              class="side-group-header"
              type="button"
              aria-expanded={shouldOpen ? "true" : "false"}
              aria-controls={`side-group-${category.slug}-items`}
              data-cat={category.slug}
              data-cat-index={idx}
            >
              <span class="side-group-number" aria-hidden="true">{String(idx + 1).padStart(2, "0")}</span>
              <span class="side-group-title" set:html={t(category.title)} />
              <span class="side-count" set:html={odo(items.length)} />
            </button>
            <ul id={`side-group-${category.slug}-items`} class="side-group-items">
              {items.map(({ item, to, href, here }) => (
                <li>
                  <a class="side-item" href={href}
                     data-match={to?.external ? undefined : href}
                     data-cat={category.slug}
                     data-slug={item.slug}
                     aria-current={cur(here)}
                     target={to?.external ? "_blank" : undefined} rel={to?.external ? "noopener" : undefined}>
                    <span class="side-thumb" set:html={thumb(item)} />
                    <span class="side-text">
                      <span class="side-name" set:html={name(item)} />
                      <span class="side-line" set:html={t(item.cardLine ?? item.summary)} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </nav>

    <p class="side-foot">
      <span set:html={t(profile.location)} /> ·
      <a href="/about#work-with-me"><span class="t-en">Contact</span><span class="t-jp" lang="ja">相談</span></a> ·
      <a href={profile.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·
      <a href="/takao-umehara-resume.pdf" target="_blank" rel="noopener"><span class="t-en">Resume</span><span class="t-jp" lang="ja">履歴書</span></a>
    </p>
  </div>
</aside>
{/* Phones (≤ 900px): the rail sits behind the Menu button, so the
    categories are also listed here, under the top bar, without opening the
    menu — one chip per category (name + count). A chip drives the same
    exclusive accordion as the rail's rows (src/scripts/site.js): it opens
    that category in the menu and highlights its cards on the page. Hidden on
    wider screens, where the rail's own rows are the list. Not persisted: it is
    re-rendered with each page and re-synced on astro:page-load. */}
<nav class="side-cats-phone" aria-label="Categories">
  <ul class="side-cats-phone-list">
    {groups.map(({ category, items, shouldOpen }, idx) => (
      <li>
        <button
          class="side-cat-chip"
          type="button"
          data-cat-index={idx}
          aria-expanded={shouldOpen ? "true" : "false"}
          aria-controls={`side-group-${category.slug}-items`}
        >
          <span class="side-cat-name" set:html={t(category.title)} />
          <span class="side-cat-count">{items.length}</span>
        </button>
      </li>
    ))}
  </ul>
</nav>
