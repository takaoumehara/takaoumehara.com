---
// The left rail. Top to bottom: the logo (the one way home), the theme and
// language controls, the clock, the one-line claim, a row of chips that says
// how much work there is and jumps to it, then the pages about the person and
// every piece of work by category — all in one card shape, so nothing has to
// be guessed at to be clickable.
//
// Site.astro persists this element across client-side navigations
// (transition:persist), so aria-current is computed twice: here for the
// built HTML and again in src/scripts/site.js after every swap, from the
// data-match paths each link carries. src/scripts/site.js also owns the
// chips' jump, the first-visit reveal, and keeping the current row in view.
import { getLibrary, orderedCategories, destination, outwardLink, samePage } from "../lib/site.mjs";
import { t, tb, esc, plain, url } from "../lib/html.mjs";

interface Props { current?: string }
const { current = Astro.url.pathname } = Astro.props;

const lib = getLibrary();
const profile = lib.profile;
const categories = orderedCategories();

// The pages about the person, as rows of the same card. A glyph stands in for
// a thumbnail — these are pages, not pieces of work, and inventing a picture
// for each would say less than one letter does.
const PAGES = [
  { href: "/about.html", glyph: "◍", label: { en: "About", jp: "自己紹介" } },
  { href: "/now/", glyph: "◉", label: { en: "Now", jp: "いま" }, match: ["/now/", "/now.html"] },
  { href: "/publications.html", glyph: "¶", label: { en: "Writing", jp: "文章" } },
  { href: "/workshop.html", glyph: "◳", label: { en: "Workshops", jp: "ワークショップ" }, match: ["/workshop.html", "/breakbias.html"] },
  { href: "/contact.html", glyph: "✉", label: { en: "Work with me", jp: "仕事の相談" }, match: ["/contact.html", "/work-with-me.html"] },
  { href: profile.studio.url, glyph: "↗", label: { en: "Studio", jp: "スタジオ" }, external: true },
];

const matches = (page) => page.match ?? [page.href];
const isCurrent = (page) => !page.external && matches(page).some((p) => samePage(p, current));
const cur = (hit) => (hit ? "page" : undefined);

const groups = categories.map((category) => {
  const items = category.groups.flatMap((g) => g.items).map((id) => lib.evidence.get(id)).filter(Boolean)
    .map((item) => {
      const to = destination(item);
      // A piece with nowhere of its own to go falls back to an anchor on its
      // category page. That anchor is NOT "the page you are standing on": the
      // hash is stripped when the current row is worked out, so every such row
      // in a category used to light up at once the moment you opened that
      // category page — two inverted cards, or more. Only a row with a page of
      // its own gets data-match.
      const own = to && !to.external ? to.url : null;
      const href = to ? to.url : `/${category.output}#${item.slug}`;
      const here = own !== null && samePage(own, current);
      // The row opens the detail page; the ↗ beside it opens the work itself.
      // It sits OUTSIDE the row's <a> — a link inside a link is not markup —
      // so .side-item keeps its selectors, its aria-current and its shape.
      return { item, to, away: outwardLink(item), own, href, here };
    });
  return { category, items };
});
const total = groups.reduce((n, g) => n + g.items.length, 0);

const name = (item) => (item.jpTitle && item.jpTitle !== (item.shortTitle ?? item.title))
  ? t({ en: item.shortTitle ?? item.title, jp: item.jpTitle })
  : esc(item.shortTitle ?? item.title);

const thumb = (item) => {
  const image = item.assets?.thumb ?? item.assets?.hero;
  if (image) return `<img src="${esc(url(image))}" alt="" loading="lazy" width="64" height="64">`;
  return `<span class="side-art" aria-hidden="true">${esc(item.assets?.artLabel ?? item.shortTitle ?? item.title)}</span>`;
};
---
<aside class="side" id="side" transition:persist="side">
  <div class="side-top">
    <a class="side-logo side-logo--bar" href="/" aria-label="Takao Umehara — home">
      <span class="side-logo-en">{profile.name}</span>
    </a>
    <button class="side-toggle" id="side-toggle" type="button" aria-expanded="false" aria-controls="side-panel">Menu</button>
  </div>

  <div class="side-panel" id="side-panel">
    <div class="side-head">
      <a class="side-logo" href="/" data-match="/" aria-current={cur(samePage("/", current))} aria-label="Takao Umehara — home">
        <span class="side-logo-en">{profile.name}</span>
        <span class="side-logo-jp">{profile.jpName}</span>
      </a>
      <div class="side-ctl">
        <button class="side-theme" id="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark mode"></button>
        <button class="side-lang" id="lang-cycle" type="button" aria-label="Switch to Japanese">JP</button>
      </div>
    </div>

    <p class="side-clock" id="side-clock" data-zone="America/New_York" data-place-en="New York" data-place-jp="ニューヨーク">
      <span data-clock-date>&nbsp;</span><span data-clock-time>&nbsp;</span>
    </p>

    <p class="side-lede" set:html={tb(profile.positioning[1])} />

    <nav class="side-chips" id="side-chips" aria-label="How much work there is">
      <a class="side-chip side-chip--all" href="/all/" data-match="/all/" aria-current={cur(samePage("/all/", current))}>
        <span class="t-en">All work</span><span class="t-jp">すべて</span>
        <span class="side-chip-n" data-count={total}>{total}</span>
      </a>
      {groups.map(({ category, items }) => (
        <button class="side-chip" type="button" data-jump={category.slug}>
          <span set:html={t(category.title)} />
          <span class="side-chip-n" data-count={items.length}>{items.length}</span>
        </button>
      ))}
    </nav>

    <nav class="side-work" aria-label="Work by category">
      <details class="side-group side-group--person" data-group="person" open>
        <summary>
          <span class="t-en">The person</span><span class="t-jp">この人について</span>
          <span class="side-count">{PAGES.length}</span>
        </summary>
        <ul>
          {PAGES.map((page) => (
            <li>
              <a class="side-item side-item--page" href={page.href}
                 data-match={page.external ? undefined : matches(page).join(" ")}
                 aria-current={cur(isCurrent(page))}
                 target={page.external ? "_blank" : undefined} rel={page.external ? "noopener" : undefined}>
                <span class="side-thumb side-thumb--glyph" aria-hidden="true">{page.glyph}</span>
                <span class="side-text"><span class="side-name" set:html={t(page.label)} /></span>
              </a>
            </li>
          ))}
        </ul>
      </details>

      {groups.map(({ category, items }) => (
        <details class="side-group" data-group={category.slug} open>
          <summary>
            <span set:html={t(category.title)} />
            <span class="side-count" data-count={items.length}>{items.length}</span>
          </summary>
          <ul>
            {items.map(({ item, to, away, own, href, here }) => (
              <li class={away ? "side-row side-row--live" : "side-row"}>
                <a class="side-item" href={href}
                   data-match={own ?? undefined}
                   aria-current={cur(here)}
                   target={to?.external ? "_blank" : undefined} rel={to?.external ? "noopener" : undefined}>
                  <span class="side-thumb" set:html={thumb(item)} />
                  <span class="side-text">
                    <span class="side-name" set:html={name(item)} />
                    <span class="side-line" set:html={t(item.cardLine ?? item.summary)} />
                  </span>
                </a>
                {away && (
                  <a class="side-live" href={away.url} target="_blank" rel="noopener"
                     aria-label={`${plain(away.label)} — ${plain(item.shortTitle ?? item.title)}`}>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </details>
      ))}
    </nav>

    <p class="side-foot"><span set:html={t(profile.location)} /> · <a href={profile.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a></p>
  </div>
</aside>
