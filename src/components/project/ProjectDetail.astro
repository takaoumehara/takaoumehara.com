---
// The project detail page, in the locked order:
//   teaser (muted loop · still · name/logo fallback, 16:9 — or a live,
//           same-origin prototype in an iframe when detail.teaser.embed is set)
//   → name (H1) + one-liner + Play (the page's only external link)
//   → Challenge | Solution
//   → body: 0–3 beats from src/case-studies/<slug>.html
//   → Role / Year / Client, and the stack in a quiet footer line.
// Everything but the body comes from the evidence record (src/lib/detail.mjs).
//
// Bento rule (Takao, 2026-09-26): every piece of text on this page sits inside
// a cell, and every cell shares one inner padding (--cell-pad), so every text
// column's left edge lines up exactly — the H1, the one-liner, Play, the
// Challenge/Solution copy, each beat and the meta line. Cells stack with
// --gap-grid, never margins. A cell can be visually invisible (no fill) —
// it still carries the same padding. The teaser is the one cell whose 16:9
// media stays flush, with no padding.
import { t, tb, esc, url } from "../../lib/html.mjs";
import { detailFields } from "../../lib/detail.mjs";
import ProjectHeroFallback from "./ProjectHeroFallback.astro";

interface Props {
  item: any;
  body?: string | null;
}

const { item, body } = Astro.props;
const d = detailFields(item);
const teaser = d.teaser;
const hasAudio = teaser.kind === "video" && item.assets?.preview?.audio === true;
// An embedded prototype may ask for its own box (a phone-shaped one, or a
// taller one at phone width) — passed as custom properties the CSS reads.
const teaserStyle = teaser.kind === "embed"
  ? `--teaser-aspect: ${teaser.aspect}; --teaser-aspect-sm: ${teaser.aspectSm}`
  : undefined;
// The name (an English-only title, by design) and a client's organization
// name are the two fields most likely to have no `.jp` counterpart. The
// site's EN/JP toggle hides .t-en with nothing to show in its place, which
// would blank the H1 and the teaser fallback entirely in Japanese — so every
// localized value in this component keeps its English text as its own jp
// fallback rather than going missing.
const loc = (v) => (v == null || typeof v === "string" ? v : { ...v, jp: v.jp ?? v.en });
const value = (v) => (v == null ? "" : typeof v === "string" ? esc(v) : t(loc(v)));
const meta = [
  { label: { en: "Role", jp: "役割" }, value: d.role },
  { label: { en: "Year", jp: "年" }, value: d.year },
  { label: { en: "Client", jp: "クライアント" }, value: d.client },
].filter((m) => m.value);
---
<article class="project-detail">
  <div class="project-bento">
    <div class={`project-teaser bento-cell${teaser.kind === "embed" ? " project-teaser--embed" : ""}`} data-vt-hero style={teaserStyle}>
      {teaser.kind === "embed" && (
        <iframe class="project-teaser-media project-teaser-frame" src={teaser.src} title={teaser.title}
                loading="lazy" referrerpolicy="same-origin"></iframe>
      )}
      {teaser.kind === "video" && (
        <video class="project-teaser-media project-video" autoplay muted loop playsinline preload="metadata"
               poster={teaser.poster ? url(teaser.poster) : undefined} aria-hidden="true">
          {teaser.webm && <source src={url(teaser.webm)} type="video/webm" />}
          {teaser.mp4 && <source src={url(teaser.mp4)} type="video/mp4" />}
        </video>
      )}
      {teaser.kind === "image" && (
        <img class="project-teaser-media" src={url(teaser.src)} alt=""
             style={[
               teaser.fit === "contain" ? "object-fit: contain" : "",
               teaser.position ? `object-position: ${teaser.position}` : "",
               teaser.background ? `background: ${teaser.background}` : "",
             ].filter(Boolean).join("; ") || undefined} />
      )}
      {teaser.kind === "fallback" && (
        <ProjectHeroFallback name={loc(teaser.name)} client={loc(teaser.client)} logo={teaser.logo} />
      )}
      {hasAudio && (
        <button class="video-sound-toggle" id="video-sound-toggle" type="button" aria-label="Enable sound">
          <span class="t-en">Sound on</span><span class="t-jp">音を出す</span>
        </button>
      )}
    </div>

    <header class="project-header bento-cell">
      {item.kind === "experiment" && item.input && (
        <span class="input-stamp project-input">{String(item.input)}</span>
      )}
      <h1 class="project-title" set:html={t(loc(d.name))} />
      {d.oneLiner && <p class="project-oneliner" set:html={tb(d.oneLiner)} />}
      {d.play && (
        <a href={d.play.href} class="project-play" target="_blank" rel="noopener">
          <span set:html={t(d.play.label)} /><span class="project-play-arrow" aria-hidden="true">↗</span>
        </a>
      )}
    </header>

    {d.challenge && (
      <section class="project-cs" aria-label="Challenge and solution">
        <div class="project-cs-cell bento-cell">
          <h2 class="project-cs-label"><span class="t-en">Challenge</span><span class="t-jp">課題</span></h2>
          <p class="project-cs-text" set:html={tb(d.challenge)} />
        </div>
        <div class="project-cs-cell bento-cell">
          <h2 class="project-cs-label"><span class="t-en">Solution</span><span class="t-jp">解決</span></h2>
          <p class="project-cs-text" set:html={tb(d.solution)} />
        </div>
      </section>
    )}

    {body && <div class="project-beats" set:html={body} />}

    <footer class="project-meta bento-cell">
      {meta.length > 0 && (
        <dl class="project-meta-list">
          {meta.map((m) => (
            <div class="project-meta-item">
              <dt set:html={t(m.label)} />
              <dd set:html={value(m.value)} />
            </div>
          ))}
        </dl>
      )}
      {d.stack.length > 0 && (
        <p class="project-stack"><span class="t-en">Stack</span><span class="t-jp">技術</span> — {d.stack.join(" · ")}</p>
      )}
    </footer>
  </div>
</article>

<style>
  /* The detail page fills the main pane at every width — the rail takes
     --side-w, this takes the rest. */
  .project-detail {
    width: 100%;
    /* Top comes from .project-page; left is 0 because the rail's right
       padding (--pane-pad) is already the one gap between its cards and the
       teaser; right is the same --pane-pad to the window edge. */
    padding: 0 var(--pane-pad) 96px 0;
  }
  /* Below 900px the rail is a top bar, not a column, so the pane carries its
     own left edge. */
  @media (max-width: 900px) {
    .project-detail { padding-left: var(--pane-pad); }
  }

  /* Every piece of the page is one cell in this column, all separated by the
     same grid gap the Challenge | Solution pair already used — never a
     margin. This is what keeps every text column's left edge identical. */
  .project-bento {
    display: flex;
    flex-direction: column;
    gap: var(--gap-grid);
  }

  /* One inner padding for every text-bearing cell. A cell can be visually
     invisible (no background, below) — it still gets this padding, so its
     text lines up with the grey Challenge/Solution cells. */
  .bento-cell {
    box-sizing: border-box;
    padding: var(--cell-pad, clamp(20px, 3vw, 32px));
    border-radius: var(--r);
  }

  /* The header and the meta footer read calm: same padding, no fill. The
     site-wide `footer { border-top }` rule (site.css) would otherwise draw a
     hairline across this cell that no other cell gets — this is a <footer>
     element only because that is the right landmark role, not a divider. */
  .project-input { margin-bottom: var(--gap-grid); }
  .project-header,
  .project-meta {
    background: transparent;
    border-top: none;
  }

  .project-teaser {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--pr-card);
    /* The one cell whose media stays flush — no inner padding. */
    padding: 0;
  }

  .project-teaser-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* A live prototype: its own aspect (16:9 unless the record says), a
     taller one at phone width so a phone-shaped remote stays touchable. */
  .project-teaser--embed { aspect-ratio: var(--teaser-aspect, 16 / 9); }
  .project-teaser-frame { border: 0; background: #fff; }
  .project-teaser-frame:focus-visible { outline: 2px solid var(--pr-blue); outline-offset: -2px; }
  @media (max-width: 768px) {
    .project-teaser--embed { aspect-ratio: var(--teaser-aspect-sm, var(--teaser-aspect, 16 / 9)); }
  }

  .video-sound-toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    padding: 8px 14px;
    border: 0;
    border-radius: var(--r-pill);
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  /* The H1 grows with the pane instead of topping out at 1267px, where the old
     76px ceiling was reached and every wider browser looked identical. */
  .project-title {
    font-family: var(--pr-ff-display);
    font-size: clamp(40px, 5.2vw, 116px);
    font-weight: var(--fw-display, 600);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--pr-ink);
    margin-bottom: 20px;
  }

  :global(html.lang-jp) .project-title {
    font-family: var(--pr-ff-jp);
    letter-spacing: -0.02em;
  }

  /* Outfit carries no CJK, so the Japanese edition's headings fall back to the
     JP face rather than to whatever the browser substitutes glyph by glyph. */
  :global(html.lang-jp) .project-cs-label { font-family: var(--pr-ff-jp); }
  :global(html.lang-jp) .project-beats :global(.beat-title) { font-family: var(--pr-ff-jp); }

  .project-title { text-wrap: balance; }
  :global(html.lang-jp) .project-title,
  :global(html.lang-jp) .project-oneliner {
    word-break: auto-phrase;
  }

  .project-oneliner {
    max-width: 64ch;
    font-size: clamp(18px, 1.4vw, 32px);
    line-height: 1.35;
    color: var(--pr-ink-2);
    margin-bottom: 28px;
  }

  .project-play {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border-radius: var(--r-pill);
    background: var(--pr-ink);
    color: var(--pr-canvas);
    font-size: var(--text-body);
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  .project-play:hover { opacity: 0.82; }
  .project-play:focus-visible { outline: 2px solid var(--pr-blue); outline-offset: 3px; }

  .project-cs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-grid);
  }

  .project-cs-cell {
    background: var(--pr-card);
  }

  .project-cs-label {
    font-family: var(--pr-ff-display);
    font-size: var(--text-sm);
    font-weight: var(--fw-display, 600);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pr-ink-2);
    margin-bottom: 16px;
  }

  /* Reference sets this copy at reading size, not caption size. */
  .project-cs-text {
    max-width: 62ch;
    font-size: clamp(16px, 1vw, 22px);
    line-height: 1.6;
    color: var(--pr-ink);
  }

  .project-meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 0;
  }

  .project-meta-list + .project-stack { margin-top: 32px; }

  .project-meta-item dt {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pr-ink-2);
    margin-bottom: 6px;
  }

  .project-meta-item dd {
    margin: 0;
    font-size: var(--text-body);
    color: var(--pr-ink);
  }

  .project-stack {
    font-size: var(--text-xs);
    color: var(--pr-ink-2); /* quiet by size and ink step, never by opacity (AA) */
    margin: 0;
  }

  /* The body arrives as raw HTML (set:html) from src/case-studies/<slug>.html,
     so it never gets this component's scoped attribute — every rule that
     touches it has to be :global(). display:contents removes this wrapper
     from the box model so each .beat becomes its own cell in .project-bento,
     sharing its gap like every other cell, rather than nesting a second gap
     inside a single flex child. */
  .project-beats { display: contents; }

  /* One beat = one bento cell: same padding as Challenge/Solution, no fill —
     beats read as quiet as the header. */
  .project-beats :global(.beat) {
    box-sizing: border-box;
    padding: var(--cell-pad, clamp(20px, 3vw, 32px));
    border-radius: var(--r);
  }
  .project-beats :global(.beat-title) {
    font-family: var(--pr-ff-display);
    font-size: clamp(20px, 1.6vw, 34px);
    font-weight: var(--fw-display, 600);
    line-height: var(--leading-lg);
    color: var(--pr-ink);
    margin-bottom: 16px;
    max-width: 30ch;
  }
  .project-beats :global(.beat-text) {
    font-size: clamp(16px, 1vw, 22px);
    line-height: 1.6;
    color: var(--pr-ink);
    max-width: 62ch;
  }
  /* Media and fact strips step down from the text by two grid units. */
  .project-beats :global(.beat-text + .beat-media),
  .project-beats :global(.beat-text + .beat-facts),
  .project-beats :global(.beat-media + .beat-facts) { margin-top: calc(var(--gap-grid) * 2); }
  /* Beat media sits inside the same padded column as the beat's own text —
     never edge to edge — so an image's left/right edges line up with the
     title and body copy above it. */
  .project-beats :global(.beat-media) {
    display: grid;
    grid-template-columns: repeat(var(--beat-cols, 1), minmax(0, 1fr));
    gap: var(--gap-grid);
    margin: 0;
  }
  .project-beats :global(.beat-media img),
  .project-beats :global(.beat-media video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r);
    background: var(--pr-card);
  }
  .project-beats :global(.beat-media--frame img),
  .project-beats :global(.beat-media--frame video) {
    aspect-ratio: 16 / 10;
    height: auto;
    object-fit: contain;
  }
  /* A beat can hold a live, same-origin tool (<figure class="beat-embed">
     with an <iframe>): the same padded column as beat images, its own
     aspect via --embed-aspect / --embed-aspect-sm, and a plain link under it
     so the tool is still reachable where frames are blocked. */
  .project-beats :global(.beat-embed) { margin: 0; }
  .project-beats :global(.beat-text + .beat-embed) { margin-top: calc(var(--gap-grid) * 2); }
  .project-beats :global(.beat-embed iframe) {
    display: block;
    width: 100%;
    aspect-ratio: var(--embed-aspect, 16 / 9);
    border: 0;
    border-radius: var(--r);
    background: #0d0f12;
  }
  .project-beats :global(.beat-embed iframe:focus-visible) { outline: 2px solid var(--pr-blue); outline-offset: 3px; }
  .project-beats :global(.beat-links) { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .project-beats :global(.beat-links .beat-link) { min-height: 24px; }

  .project-beats :global(.beat-caption) {
    grid-column: 1 / -1;
    margin-top: 8px;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--pr-ink-2);
  }
  .project-beats :global(.beat-link) {
    display: inline-block;
    margin-top: 12px;
    font-size: var(--text-sm);
    color: var(--pr-ink);
    text-underline-offset: 3px;
  }
  .project-beats :global(.beat-facts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--gap-grid);
  }
  .project-beats :global(.beat-fact) {
    padding: 20px;
    border-radius: var(--r);
    background: var(--pr-card);
  }
  .project-beats :global(.beat-fact-num) {
    font-family: var(--pr-ff-display);
    font-size: clamp(28px, 3.4vw, 56px);
    font-weight: var(--fw-display, 600);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--pr-ink);
    margin-bottom: 8px;
  }
  .project-beats :global(.beat-fact-label) {
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--pr-ink-2);
  }

  @media (max-width: 768px) {
    .project-cs { grid-template-columns: 1fr; }
    .project-beats :global(.beat-media) { grid-template-columns: repeat(var(--beat-cols-sm, 1), minmax(0, 1fr)); }
    .project-beats :global(.beat-embed iframe) { aspect-ratio: var(--embed-aspect-sm, var(--embed-aspect, 16 / 9)); }
  }
</style>

<script>
  function initTeaser() {
    const video = document.querySelector<HTMLVideoElement>(".project-video");
    if (!video) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) video.pause();
    const toggle = document.getElementById("video-sound-toggle");
    toggle?.addEventListener("click", () => {
      video.muted = !video.muted;
      toggle.setAttribute("aria-label", video.muted ? "Enable sound" : "Mute sound");
    });
  }
  // Beats arrive as raw HTML (set:html) from src/case-studies/<slug>.html, so
  // Astro never sees them as template elements — mark each one as a bento
  // cell here instead, so it is reachable the same way every other cell is
  // (site.js's boot sequence, any future per-cell behaviour).
  function markBeatCells() {
    document.querySelectorAll(".project-beats > .beat").forEach((el) => el.classList.add("bento-cell"));
  }
  function init() {
    initTeaser();
    markBeatCells();
  }
  document.addEventListener("astro:page-load", init);
</script>
