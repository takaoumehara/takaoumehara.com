---
// The detail teaser when there is no real still or clip of the work: the same
// 16:9 box, filled with the project name (and client, when commercial) set
// large, or the client's logo. Flat card grey in both themes — never a
// gradient, never "coming soon".
import { t, esc, url, plain } from "../../lib/html.mjs";

type Localized = string | { en: string; jp?: string };
interface Props {
  name: Localized;
  client?: Localized;
  logo?: string;       // site-relative path to a logo image
  logoAlt?: string;
}

const { name, client, logo, logoAlt } = Astro.props;
const label = [plain(name), plain(client)].filter(Boolean).join(" — ");
---
<div class="hero-fallback" role="img" aria-label={label}>
  {logo ? (
    <img class="hero-fallback-logo" src={esc(url(logo))} alt={logoAlt ?? plain(client) ?? plain(name)} />
  ) : (
    <p class="hero-fallback-name" aria-hidden="true" set:html={t(name)} />
  )}
  {client && <p class="hero-fallback-client" aria-hidden="true" set:html={t(client)} />}
</div>

<style>
  .hero-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 24px);
    padding: 8%;
    background: var(--pr-card);
    color: var(--pr-ink);
    text-align: center;
  }

  .hero-fallback-name {
    font-family: "Outfit", var(--pr-ff-display);
    font-size: clamp(44px, 9vw, 136px);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  :global(html.lang-jp) .hero-fallback-name {
    font-family: var(--pr-ff-jp);
    letter-spacing: -0.02em;
  }

  .hero-fallback-logo {
    max-width: 44%;
    max-height: 44%;
    object-fit: contain;
  }

  .hero-fallback-client {
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pr-ink-2);
  }
</style>
