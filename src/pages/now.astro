---
// Dedicated Lab Bench page (/now): active ventures, prototypes, and tools in
// motion. Served at both now.html and now/ — see src/pages/now/index.astro —
// mirroring the old build's two outputs for the same content.
import Site from "../layouts/Site.astro";
import NowPage from "../components/now/NowPage.astro";
import { getLibrary } from "../lib/site.mjs";

const lib = getLibrary();
const nowData = lib.now;

const seo = {
  title: "Now — Takao Umehara",
  description: "Active ventures, running prototypes, and open-source tools currently on Takao Umehara's desk.",
};
---
<Site
  title={seo.title}
  description={seo.description}
  canonical="https://takaoumehara.com/now"
  current="/now.html"
>
  <NowPage nowData={nowData} />
</Site>
