---
// The home page. The right pane (About → Now → showcase → Updates) is
// src/components/home/HomeMain.astro, shared with the Japanese edition
// (src/pages/ja/index.astro). "Work" — the filter pills and the full work
// grid — is /work (src/pages/work.astro).
import Site from "../layouts/Site.astro";
import HomeMain from "../components/home/HomeMain.astro";
import { getLibrary, defaultLens } from "../lib/site.mjs";

const lib = getLibrary();
const lens = defaultLens();
---
<Site title={lens.seo.title} description={lens.seo.description} canonical="https://takaoumehara.com/">
  <HomeMain lib={lib} />
</Site>
