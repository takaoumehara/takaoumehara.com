---
// The home page: Porto Rocha–like bento layout with left rail + right stage
// News cells from Interactive launches (Mar–Sep 2026), filters, and work grid
import Site from "../layouts/Site.astro";
import WorkGrid from "../components/grid/WorkGrid.astro";
import { tb, t } from "../lib/html.mjs";
import { getLibrary, gridEntries, orderedCategories, defaultLens } from "../lib/site.mjs";

const lib = getLibrary();
const lens = defaultLens();
const entries = gridEntries();
const categories = orderedCategories();

// Simplified filters per IA redesign: All / Interactive / AI / Design
const FILTERS = [
  { id: "all", label: { en: "All", jp: "すべて" }, count: entries.length },
  { id: "interactive", label: { en: "Interactive", jp: "インタラクティブ" }, count: 0 },
  { id: "ai", label: { en: "AI", jp: "AI" }, count: 0 },
  { id: "design", label: { en: "Design", jp: "デザイン" }, count: 0 },
];

// Calculate counts
const catMap = new Map(categories.map(c => [c.slug, c]));
const interactiveCat = catMap.get("interactive");
const aiProductsCat = catMap.get("ai-products");
const aiToolsCat = catMap.get("ai-tools");
const brandCat = catMap.get("brand");
const workCat = catMap.get("work");

if (interactiveCat) {
  FILTERS[1].count = interactiveCat.groups.reduce((n, g) => n + g.items.length, 0);
}
const aiCount = (aiProductsCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0) + 
                (aiToolsCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0);
FILTERS[2].count = aiCount;
const designCount = (brandCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0) + 
                    (workCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0);
FILTERS[3].count = designCount;

// News cells from content-ia §5 (Interactive launch fiction · Mar–Sep 2026)
const NEWS = [
  {
    date: "2026-03-18",
    title: { en: "Typespace launches: language as a walkable constellation", jp: "Typespace 公開 — 歩きまわる文字の星座" },
    lead: { 
      en: "Typespace is live — a hand-authored 3D typographic world where words hold mass, orbit, and sound. No generative filler: every cluster is composed in Next, r3f, GLSL, and Web Audio. Enter, drift, and read with your body.",
      jp: "Typespace 公開。言葉が質量・軌道・音を持つ、手作業の三次元タイポ世界。生成の埋め草はなし。Next / r3f / GLSL / Web Audio で組んだ星座を、身体で読んでほしい。"
    },
    href: "/projects/typespace.html"
  },
  {
    date: "2026-05-28",
    title: { en: "Resona: meaning that lands as motion first", jp: "Resona — 意味は、まず動きとして着地する" },
    lead: {
      en: "Resona opens to the public — an interactive piece where particle fields and pseudo-haptic cues carry intent before any sentence appears. Sparse controls, physical feedback. Built for moments that should be felt, then understood.",
      jp: "Resona 一般公開。パーティクルと疑似触覚の合図が、文より先に意図を運ぶ。操作は少なく、フィードバックは身体的。感じてから理解するための作品。"
    },
    href: "/projects/resona.html"
  },
  {
    date: "2026-08-21",
    title: { en: "Late-summer playable: Rakugaki Jam meets Kao Game", jp: "晩夏のプレイアブル — Rakugaki Jam × Kao Game" },
    lead: {
      en: "A seasonal interactive drop — sketch energy of Rakugaki Jam crossed with face-play of Kao Game. Short sessions, loud joy, shareable moments. Part of the 2026 interactive launch trail from spring through early fall.",
      jp: "季節のインタラクティブ投下。Rakugaki Jam のスケッチの勢いと、Kao Game の顔遊びが交差する。短いセッション、大きな喜び、共有したくなる瞬間。2026年春〜初秋のインタラクティブラウンチの一環。"
    },
    href: "/"
  }
];
---
<Site title={lens.seo.title} description={lens.seo.description} canonical="https://takaoumehara.com/">
  <main class="cat-page grid-home" data-category="home">
    <header class="cat-head">
      <p class="grid-headline" set:html={tb(lib.profile.positioning[1])} />
      <div class="grid-filters" role="group" aria-label="Filter work by discipline">
        {FILTERS.map((f, i) => (
          <button type="button" class={`filter-btn${i === 0 ? " is-active" : ""}`} data-filter={f.id}>
            <span set:html={t(f.label)} />
            <span class="filter-count">{f.count}</span>
          </button>
        ))}
      </div>
    </header>
    
    <!-- News bento cells -->
    <section class="news-bento">
      <h2 class="news-label">
        <span class="t-en">Recent</span>
        <span class="t-jp">最近</span>
      </h2>
      <div class="news-grid">
        {NEWS.map((item) => (
          <a href={item.href} class="news-card">
            <time class="news-date">{item.date}</time>
            <h3 class="news-title" set:html={t(item.title)} />
            <p class="news-lead" set:html={t(item.lead)} />
          </a>
        ))}
      </div>
    </section>
    
    <WorkGrid entries={entries} />
  </main>
</Site>

<style>
  .news-bento {
    margin-bottom: 64px;
  }
  
  .news-label {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--ink-dim);
    margin-bottom: 24px;
  }
  
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  
  .news-card {
    display: block;
    padding: 24px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  
  .news-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  
  .news-date {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-dim);
    margin-bottom: 12px;
  }
  
  .news-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    margin-bottom: 12px;
  }
  
  .news-lead {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-mid);
  }
  
  @media (max-width: 768px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // ── Home grid filter bar ──
  (() => {
    const btns = document.querySelectorAll(".grid-home .filter-btn");
    const cards = document.querySelectorAll(".grid-home .cat-card[data-category]");
    if (!btns.length || !cards.length) return;
    
    // Map simplified filters to original category slugs
    const filterMap = {
      'all': () => true,
      'interactive': (cats) => cats.includes('interactive'),
      'ai': (cats) => cats.includes('ai-products') || cats.includes('ai-tools'),
      'design': (cats) => cats.includes('brand') || cats.includes('work')
    };

    function applyFilter(filter) {
      btns.forEach((b) => b.classList.toggle("is-active", b.dataset.filter === filter));
      const matcher = filterMap[filter];
      cards.forEach((card) => {
        const cats = (card.dataset.category || "").split(" ");
        const show = matcher(cats);
        card.classList.toggle("is-hidden", !show);
      });
      try {
        if (filter !== "all") history.replaceState(null, "", "#" + filter);
        else if (window.location.hash) history.replaceState(null, "", window.location.pathname);
      } catch (e) {}
    }

    btns.forEach((b) => b.addEventListener("click", () => applyFilter(b.dataset.filter)));

    const hash = window.location.hash.replace("#", "").toLowerCase();
    if (hash && filterMap[hash]) {
      applyFilter(hash);
    }
  })();
</script>
