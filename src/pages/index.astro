---
// The landing page: the name, the sentence, and every piece of work as a
// bento that re-cuts itself on each reload. No left rail — the rail and the
// filter row arrive on the first click (src/components/landing/Landing.astro
// says why). The canonical long-form story still builds, at /lens/default/.
import Site from "../layouts/Site.astro";
import Landing from "../components/landing/Landing.astro";
import { getLibrary, gridEntries, defaultLens } from "../lib/site.mjs";

const lib = getLibrary();
const lens = defaultLens();
const entries = gridEntries();
---
<Site
  title={lens.seo.title}
  description={lens.seo.description}
  canonical="https://takaoumehara.com/"
  chrome={false}
  footer={false}
>
  <Landing profile={lib.profile} entries={entries} />
</Site>
