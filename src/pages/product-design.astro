---
// Category page: Product & Experience Design. src/categories/work.json is the
// data; this file only wires it into the shell. Edit the category or the
// underlying evidence, not this page.
//
// It is served at /product-design.html rather than /work.html: /work is the
// canonical "All work" archive (src/pages/work.astro), and Astro resolves
// work.astro, work.html and work/ to one route, so the category needed its own
// address. vercel.json redirects it to /work?filter=design, the same way it
// redirects the other four category pages.
import Site from "../layouts/Site.astro";
import CategoryPage from "../components/category/CategoryPage.astro";
import { getCategories, getLibrary } from "../lib/site.mjs";

const lib = getLibrary();
const category = getCategories().find((c) => c.slug === "work");
const first = lib.evidence.get(category.groups[0].items[0]);
---
<Site
  title={category.seo.title}
  description={category.seo.description}
  canonical={"https://takaoumehara.com/" + category.output}
  ogImage={first?.assets?.hero ?? first?.assets?.thumb}
  current={"/" + category.output}
>
  <CategoryPage category={category} lib={lib} />
</Site>
