---
// /lab/motion — the Motion Lab as a tool anyone can use on their own page
// (docs/product-idea.md "Chosen direction"): put a page on the stage — Takao's
// site, a screenshot of yours, or a URL's title / description / share image —
// pick a preset, a cover and a reveal, watch it on a desktop and a phone
// frame, and take the JSON home. Every parameter stays one link away (/?lab=1).
//
// A full-viewport tool, not a page of the site (no Site.astro shell). The
// stages are /lab/stage iframes (src/pages/lab/[page].astro) driven by
// postMessage from src/scripts/lab-tool.js; the URL stage reads
// /api/lab/peek. noindex for now.
//
// The stage is built only where unpublished pages are (src/lib/draft.mjs), so
// until it is published a production build keeps this address pointing at the
// panel on the home page instead of showing empty frames.
import "../../styles/tokens.css";
import "../../styles/lab-tool.css";
import { draftPagesBuilt } from "../../lib/draft.mjs";

const built = draftPagesBuilt();
const fonts = "https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&family=Inter:wght@400&family=Geist+Mono:wght@300;400;500&family=Noto+Sans+JP:wght@400&display=swap";
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <script is:inline>
    try { document.documentElement.setAttribute("data-theme", localStorage.getItem("tu-theme") || "light"); } catch (e) {}
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  {!built && <meta http-equiv="refresh" content="0; url=/?lab=1">}
  <title>Motion Lab — Takao Umehara</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href={fonts} rel="stylesheet">
</head>
<body class="lt">
  {!built ? (
    <p class="lt-fallback"><a href="/?lab=1">Open the Motion Lab →</a></p>
  ) : (
    <div class="lt-app">
      <div class="lt-controls">
        <header class="lt-head">
          <p class="lt-label">Motion Lab</p>
          <h1 class="lt-title">Try a loading on your own page</h1>
          <p class="lt-lede">Put your page on the stage, pick a motion, take the JSON home.</p>
        </header>

        <fieldset class="lt-card">
          <legend class="lt-label">Stage</legend>
          <div class="lt-seg">
            <label><input type="radio" name="lt-stage" value="site" checked /><span>Takao's site</span></label>
            <label><input type="radio" name="lt-stage" value="shot" /><span>Your screenshot</span></label>
            <label><input type="radio" name="lt-stage" value="peek" /><span>A URL</span></label>
          </div>
          <div class="lt-sub" data-for="shot" hidden>
            <label class="lt-drop" id="lt-drop">
              <input type="file" id="lt-file" class="lt-vh" accept="image/*" />
              <span>Drop a screenshot here, paste it, or <u>choose a file</u></span>
              <span class="lt-label">Any image · up to 4 MB</span>
            </label>
            <label class="lt-field">
              <span class="lt-label">Title on the stage</span>
              <input type="text" id="lt-title" value="Your site" maxlength="120" autocomplete="off" />
            </label>
          </div>
          <form class="lt-sub" data-for="peek" id="lt-peek" hidden>
            <label class="lt-field">
              <span class="lt-label">Page URL</span>
              <input type="url" id="lt-url" placeholder="https://example.com" required autocomplete="url" />
            </label>
            <button type="submit" class="lt-btn">Load the page</button>
          </form>
        </fieldset>

        <section class="lt-card" aria-labelledby="lt-motion-h">
          <h2 id="lt-motion-h" class="lt-label">Motion</h2>
          <label class="lt-field"><span class="lt-label">Preset</span><select id="lt-preset"></select></label>
          <label class="lt-field"><span class="lt-label">Cover</span><select id="lt-cover"></select></label>
          <label class="lt-field"><span class="lt-label">Reveal</span><select id="lt-reveal"></select></label>
          <div class="lt-row">
            <button type="button" id="lt-load" class="lt-btn">Replay load</button>
            <button type="button" id="lt-nav" class="lt-btn">Page change</button>
          </div>
          <label class="lt-switch"><input type="checkbox" role="switch" id="lt-phone" checked /><span>Phone check</span></label>
          <a class="lt-link" id="lt-fine" href="/?lab=1" target="_blank" rel="noopener">Fine-tune (all parameters) ↗</a>
        </section>

        <!-- Keep or toss: src/scripts/motion-pick.js draws its own labelled card here. -->
        <div id="lab-pick"></div>

        <section class="lt-card" aria-label="Take it home">
          <div class="lt-row"><button type="button" id="lt-copy" class="lt-btn">Copy JSON</button></div>
          <p id="lt-status" class="lt-status" role="status"></p>
        </section>
      </div>

      <main class="lt-stages" aria-label="Stages">
        <p class="lt-note" id="lt-still" hidden>Reduced motion is on, so the stages show each result at once and nothing plays. You can still choose and copy a setting.</p>
        <div class="lt-frames" id="lt-frames"></div>
      </main>
    </div>
  )}
  {built && <script>import "../../scripts/lab-tool.js";</script>}
</body>
</html>
