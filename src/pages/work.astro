---
// The All Work page: fullscreen grid WITHOUT left rail, with filters and search.
// This is the canonical work archive page at /work.
//
// The grid itself is a "free" bento, not the fixed 3-column PORTO ROCHA grid
// (src/components/grid/WorkGrid.astro / src/styles/grid.css) every other
// page uses: tiles vary in size (a "feature" 2x2, a "wide" 2x1, and the plain
// 1x1) and pack densely (grid-auto-flow: dense), the way the pre-Astro
// "Bento: a landing that re-cuts itself" branch (origin/claude/exciting-cerf-xgoyxb,
// src/lib/bentoShapes.mjs's BENTO_PATTERNS/cutBento) varied tile width per
// row — ported here as a per-tile size class instead of that row-summed
// layout, because dense packing (not a fixed 12-column row) is what keeps the
// grid whole while the filter bar hides and reveals tiles. gridEntries()
// already orders Interactive first (src/lib/site.mjs's CATEGORY_ORDER), so
// the deterministic size cycle below opens on an Interactive feature tile
// without any extra sort.
import Site from "../layouts/Site.astro";
import { tb, t, mediaFill } from "../lib/html.mjs";
import { cardName } from "../lib/labels.mjs";
import { getLibrary, gridEntries, orderedCategories, destination } from "../lib/site.mjs";

const lib = getLibrary();
const entries = gridEntries();
const categories = orderedCategories();

// One size per tile, in order, deterministic (so /work and /ja/work — should
// it ever exist — and every rebuild render identically). "feature" = 2x2,
// "wide" = 2x1, anything else = 1x1. Cycle opens on "feature", which lands on
// the first (Interactive) tile.
const SIZE_CYCLE = ["feature", "normal", "wide", "normal", "normal", "feature", "normal", "wide", "normal", "normal"];
const sizeFor = (i) => SIZE_CYCLE[i % SIZE_CYCLE.length];
const tiles = entries.map(({ item, category }, i) => {
  const to = destination(item);
  const stamp = item.kind === "experiment" && item.input ? String(item.input) : null;
  return { item, category, to, stamp, size: sizeFor(i) };
});

const FILTERS = [
  { id: "all", label: { en: "All", jp: "すべて" }, count: entries.length },
  { id: "interactive", label: { en: "Interactive", jp: "インタラクティブ" }, count: 0 },
  { id: "ai", label: { en: "AI", jp: "AI" }, count: 0 },
  { id: "design", label: { en: "Design", jp: "デザイン" }, count: 0 },
];

// Calculate counts for simplified filters
const catMap = new Map(categories.map(c => [c.slug, c]));
const interactiveCat = catMap.get("interactive");
const aiProductsCat = catMap.get("ai-products");
const aiToolsCat = catMap.get("ai-tools");
const brandCat = catMap.get("brand");
const workCat = catMap.get("work");

if (interactiveCat) {
  FILTERS[1].count = interactiveCat.groups.reduce((n, g) => n + g.items.length, 0);
}
// AI = ai-products + ai-tools
const aiCount = (aiProductsCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0) + 
                (aiToolsCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0);
FILTERS[2].count = aiCount;
// Design = brand + work
const designCount = (brandCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0) + 
                    (workCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0);
FILTERS[3].count = designCount;
---
<Site 
  title="All Work — Takao Umehara" 
  description="Complete portfolio of interactive experiences, AI products, and design work by Takao Umehara"
  canonical="https://takaoumehara.com/work"
  bodyClass="work-fullscreen"
>
  <main class="work-page-full" data-category="work">
    <header class="work-header">
      <div class="work-header-top">
        <a class="work-back" href="/">← <span class="t-en">Home</span><span class="t-jp">ホーム</span></a>
        <div class="work-controls">
          <button class="work-search-btn" id="work-search-toggle" type="button" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="8" cy="8" r="6"/>
              <path d="M13 13l5 5"/>
            </svg>
          </button>
          <button class="side-theme" data-theme-switch="true" type="button" role="switch" aria-checked="false" aria-label="Dark mode"></button>
          <button class="side-lang" data-lang-cycle="true" type="button" aria-label="Switch to Japanese">JP</button>
        </div>
      </div>
      
      <div class="work-search-panel" id="work-search-panel" hidden>
        <input 
          type="search" 
          class="work-search-input" 
          id="work-search-input"
          placeholder="Search work…"
          data-placeholder-en="Search work…"
          data-placeholder-jp="作品を検索…"
        />
      </div>
      
      <div class="work-filters" role="group" aria-label="Filter work by discipline">
        {FILTERS.map((f, i) => (
          <button type="button" class={`filter-btn${i === 0 ? " is-active" : ""}`} data-filter={f.id}>
            <span set:html={t(f.label)} />
            <span class="filter-count">{f.count}</span>
          </button>
        ))}
      </div>
    </header>

    <div class="work-bento" id="work-bento">
      {tiles.map(({ item, category, to, stamp, size }) => (
        <article
          class={`tile tile--${size} cat-card grid-card bento-cell`}
          id={item.slug}
          data-href={to ? to.url : undefined}
          data-external={to?.external ? "true" : undefined}
          data-category={category}
          tabindex={to ? "0" : undefined}
        >
          <div class="tile-media" set:html={mediaFill(item)} />
          {stamp && <span class="input-stamp">{stamp}</span>}
          <div class="tile-body">
            <h3 class="cat-card-title tile-title" set:html={cardName(item)} />
            <p class="cat-card-desc tile-desc" set:html={tb(item.cardLine ?? item.summary)} />
          </div>
          {to && (
            <a
              class="cat-card-cta"
              href={to.url}
              target={to.external ? "_blank" : undefined}
              rel={to.external ? "noopener" : undefined}
            >
              <span class="sr-only" set:html={t(to.label)} />
            </a>
          )}
        </article>
      ))}
    </div>
  </main>
</Site>

<style>
  /* The rail is dropped and the shell collapses to one column in
     src/styles/shell.css (body.work-fullscreen), so those rules survive a
     View Transitions swap. This page then runs the full viewport. */
  .work-page-full {
    width: 100%;
    padding: clamp(24px, 3vw, 56px) var(--gutter);
  }

  .work-header {
    margin-bottom: 40px;
  }

  .work-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }

  .work-back {
    font-size: var(--text-md);
    color: var(--ink);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  
  .work-back:hover {
    opacity: 0.7;
  }
  
  .work-controls {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  
  /* The chrome matches the rail's controls: a grey disc, no hairline. */
  .work-search-btn {
    appearance: none;
    border: 0;
    border-radius: 50%;
    background: var(--pr-card);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--ink);
    transition: background 140ms ease;
  }

  .work-search-btn:hover {
    background: var(--pr-card-2);
  }

  .work-search-panel {
    margin-bottom: 24px;
    animation: slideDown 0.2s ease;
  }

  .work-search-input {
    width: 100%;
    padding: 12px var(--sp-3);
    font-size: var(--text-body);
    border: 1px solid var(--pr-line);
    border-radius: var(--r-pill);
    background: var(--pr-card);
    color: var(--ink);
    font-family: inherit;
  }

  .work-search-input:focus {
    outline: none;
    border-color: var(--pr-blue);
    background: var(--pr-canvas);
  }

  /* Same gutter as the grid below it (src/styles/grid.css). */
  .work-filters {
    display: flex;
    gap: var(--gap-grid);
    flex-wrap: wrap;
  }

  /* Pills, like the home page's — grid.css already styles .filter-btn; these
     only add the taller hit area this header wants. */
  .filter-btn {
    padding: 10px var(--sp-3);
    font-size: var(--text-body);
  }

  /* ── The free grid ──────────────────────────────────────────────────────
     A "fairly free" bento, not the fixed 3-column PORTO ROCHA grid every
     other page uses: a base tile is 1x1, some are "wide" (2x1) and a few are
     "feature" (2x2) — src/pages/work.astro's SIZE_CYCLE assigns the class
     deterministically, opening on Interactive. grid-auto-flow: dense means
     that hiding tiles (the filter bar, the search box, both toggle
     .is-hidden → display:none via src/styles/grid.css) never leaves a hole:
     the remaining tiles re-pack up into it. */
  .work-bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 220px;
    gap: var(--gap-grid);
    grid-auto-flow: dense;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r);
    background: var(--pr-card);
    grid-column: span 1;
    grid-row: span 1;
  }
  .tile--wide { grid-column: span 2; }
  .tile--feature { grid-column: span 2; grid-row: span 2; }
  .tile-media {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    background: var(--pr-card-2);
  }
  .tile-media img,
  .tile-media video,
  .tile-media .card-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms cubic-bezier(.2, .7, .2, 1);
  }
  .tile[data-href]:hover .tile-media img { transform: scale(1.02); }
  .tile-body {
    flex: none;
    padding: var(--cell-pad, clamp(20px, 3vw, 32px));
  }
  /* A "feature" tile's media is the point — the caption sits tighter so the
     image still reads as the largest thing on the tile. */
  .tile--feature .tile-body { padding-top: calc(var(--cell-pad, clamp(20px, 3vw, 32px)) * 0.6); }
  .tile-title { margin: 0 0 2px; }
  .tile--feature .tile-title { font-size: var(--text-lg); }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @media (max-width: 768px) {
    .work-page-full {
      padding: 24px var(--gutter);
    }

    .work-filters {
      gap: 8px;
    }

    .filter-btn {
      padding: 8px 12px;
      font-size: 13px;
    }

    /* Fewer columns, and a feature/wide tile only doubles width, never
       height — a 2x2 square at 2 columns wide would run the whole first
       screen. */
    .work-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 200px;
    }
    .tile--feature { grid-row: span 1; }
  }

  /* One column, no horizontal scroll: every tile (feature and wide included)
     is full width, stacked. */
  @media (max-width: 480px) {
    .work-bento {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 240px;
    }
    .tile--wide,
    .tile--feature {
      grid-column: span 1;
    }
  }
</style>

<script>
  // Filter functionality
  (() => {
    const btns = document.querySelectorAll(".work-page-full .filter-btn");
    const cards = document.querySelectorAll(".work-page-full .cat-card[data-category]");
    if (!btns.length || !cards.length) return;
    
    // Map simplified filters to original category slugs
    const filterMap = {
      'all': () => true,
      'interactive': (cats) => cats.includes('interactive'),
      'ai': (cats) => cats.includes('ai-products') || cats.includes('ai-tools'),
      'design': (cats) => cats.includes('brand') || cats.includes('work')
    };

    function applyFilter(filter) {
      btns.forEach((b) => b.classList.toggle("is-active", b.dataset.filter === filter));
      const matcher = filterMap[filter];
      cards.forEach((card) => {
        const cats = (card.dataset.category || "").split(" ");
        const show = matcher(cats);
        card.classList.toggle("is-hidden", !show);
      });
      try {
        if (filter !== "all") history.replaceState(null, "", "#" + filter);
        else if (window.location.hash) history.replaceState(null, "", window.location.pathname);
      } catch (e) {}
    }

    btns.forEach((b) => b.addEventListener("click", () => applyFilter(b.dataset.filter)));

    // Either form opens a discipline: #design, or ?filter=design, which is what
    // vercel.json sends the old category addresses to.
    const params = new URLSearchParams(window.location.search);
    const requested = (params.get("filter") || window.location.hash.replace("#", "")).toLowerCase();
    if (requested && filterMap[requested]) {
      applyFilter(requested);
    }
  })();
  
  // Search toggle
  (() => {
    const toggle = document.getElementById("work-search-toggle");
    const panel = document.getElementById("work-search-panel");
    const input = document.getElementById("work-search-input");
    
    if (!toggle || !panel || !input) return;
    
    toggle.addEventListener("click", () => {
      const isHidden = panel.hasAttribute("hidden");
      if (isHidden) {
        panel.removeAttribute("hidden");
        input.focus();
      } else {
        panel.setAttribute("hidden", "");
        input.value = "";
        // Clear search filter
        document.querySelectorAll(".work-page-full .cat-card").forEach(c => {
          c.style.display = "";
        });
      }
    });
    
    // Simple search
    input.addEventListener("input", (e) => {
      const query = e.target.value.toLowerCase();
      const cards = document.querySelectorAll(".work-page-full .cat-card");
      cards.forEach((card) => {
        const text = card.textContent.toLowerCase();
        card.style.display = text.includes(query) ? "" : "none";
      });
    });
  })();
</script>
