---
// The Work page: fullscreen grid WITHOUT left rail, with filters and search.
// This is the canonical work archive page at /work.
//
// The grid itself is a "free" bento, not the fixed 3-column PORTO ROCHA grid
// (src/components/grid/WorkGrid.astro / src/styles/grid.css) every other
// page uses: tiles vary in size (a "feature" 2x2, a "wide" 2x1, and the plain
// 1x1) and pack densely (grid-auto-flow: dense), the way the pre-Astro
// "Bento: a landing that re-cuts itself" branch (origin/claude/exciting-cerf-xgoyxb,
// src/lib/bentoShapes.mjs's BENTO_PATTERNS/cutBento) varied tile width per
// row — ported here as a per-tile size class instead of that row-summed
// layout, because dense packing (not a fixed 12-column row) is what keeps the
// grid whole while the filter bar hides and reveals tiles. gridEntries()
// already orders Interactive first (src/lib/site.mjs's CATEGORY_ORDER), so
// the deterministic size cycle below opens on an Interactive feature tile
// without any extra sort.
import Site from "../layouts/Site.astro";
import { tb, t, mediaFill, esc } from "../lib/html.mjs";
import { cardName } from "../lib/labels.mjs";
import { getLibrary, gridEntries, orderedCategories, destination } from "../lib/site.mjs";
import ContactCta from "../components/ContactCta.astro";
import profile from "../data/profile.json";

const lib = getLibrary();
let entries = gridEntries();
const categories = orderedCategories();

// Default order: the curated `featured` rank on the records (Takao, 2026-10-06:
// what best shows who he is, not the biggest brand names — Intent First,
// Verizon AI Workflow, Resona, Typespace, the open tools, T-Mobile), then
// everything else in gridEntries order. Stable: index breaks ties, and an
// unranked record never compares as NaN.
const rank = (item) => (Number.isInteger(item.featured) ? item.featured : Number.MAX_SAFE_INTEGER);
entries = entries
  .map((e, i) => ({ e, i }))
  .sort((a, b) => rank(a.e.item) - rank(b.e.item) || a.i - b.i)
  .map(({ e }) => e);

// One size per tile, in order, deterministic (so /work and /ja/work — should
// it ever exist — and every rebuild render identically). "feature" = 2x2,
// "wide" = 2x1, anything else = 1x1. Cycle opens on "feature", which lands on
// the first (Intent First) featured tile.
const SIZE_CYCLE = ["feature", "normal", "wide", "normal", "normal", "feature", "normal", "wide", "normal", "normal"];
const sizeFor = (i) => SIZE_CYCLE[i % SIZE_CYCLE.length];
// Generate meta line for tiles with proper engagement and type labels (bilingual)
const getMeta = (item) => {
  const parts_en = [], parts_jp = [];

  // Get year from period or year field
  let year = null;
  if (item.period?.start && item.period?.end && item.period.end !== "present") {
    year = `${item.period.start}–${item.period.end}`;
  } else if (item.period?.start && item.period?.end === "present") {
    year = { en: `${item.period.start}–Present`, jp: `${item.period.start}–現在` };
  } else if (item.period?.start) {
    year = item.period.start;
  } else if (item.year) {
    year = item.year;
  }

  // Prioritize by kind first
  if (item.kind === "experiment") {
    // Interactive experiences
    parts_en.push("Interactive");
    parts_jp.push("インタラクティブ");
  } else if (item.kind === "venture" || item.engagement === "own-venture") {
    // Ventures (own or otherwise)
    parts_en.push("Own venture");
    parts_jp.push("自身のベンチャー");
  } else if (item.kind === "tool" || item.engagement === "open-source") {
    // Tools
    parts_en.push("Open tool");
    parts_jp.push("オープンツール");
  } else if (item.engagement === "concept") {
    // Self-initiated concepts
    parts_en.push("Self-initiated concept");
    parts_jp.push("自主提案");
  } else if (item.kind === "project" && (item.detail?.client || item.organization)) {
    // Client projects: the record's own client line (detail.client, which
    // carries the relationship, e.g. "T-Mobile (via Concentrix Catalyst)"),
    // else the organization.
    const c = item.detail?.client ?? item.organization;
    const client = typeof c === "string" ? { en: c, jp: c } : c;
    if (item.engagement === "contract") {
      parts_en.push(`${client.en} · Contract`);
      parts_jp.push(`${client.jp} · 契約`);
    } else {
      parts_en.push(client.en);
      parts_jp.push(client.jp);
    }
  }

  if (year) {
    parts_en.push(typeof year === "string" ? year : year.en);
    parts_jp.push(typeof year === "string" ? year : year.jp);
  }

  if (parts_en.length === 0) return null;
  return `<span class="t-en">${esc(parts_en.join(" · "))}</span><span class="t-jp" lang="ja">${esc(parts_jp.join(" · "))}</span>`;
};

const tiles = entries.map(({ item, category }, i) => {
  const to = destination(item);
  const stamp = item.kind === "experiment" && item.input ? String(item.input) : null;
  const meta = getMeta(item);
  return { item, category, to, stamp, size: sizeFor(i), meta };
});

const FILTERS = [
  { id: "all", label: { en: "All", jp: "すべて" }, count: entries.length },
  { id: "product", label: { en: "Product", jp: "プロダクト" }, count: 0 },
  { id: "ai", label: { en: "AI", jp: "AI" }, count: 0 },
  { id: "interactive", label: { en: "Interactive", jp: "インタラクティブ" }, count: 0 },
  { id: "tools", label: { en: "Tools", jp: "ツール" }, count: 0 },
];

// Calculate counts for the new filter categories
// Each project belongs to exactly ONE non-All filter:
// Product = work + brand
// AI = ai-products only
// Interactive = interactive
// Tools = ai-tools only
// Note: verizon-ai-workflow is in ai-products (primary), removed from work to avoid double-counting
const catMap = new Map(categories.map(c => [c.slug, c]));
const interactiveCat = catMap.get("interactive");
const aiProductsCat = catMap.get("ai-products");
const aiToolsCat = catMap.get("ai-tools");
const brandCat = catMap.get("brand");
const workCat = catMap.get("work");

// Product filter = brand + work (client/product design)
const productCount = (brandCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0) +
                     (workCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0);
FILTERS[1].count = productCount;

// AI = ai-products only
const aiCount = aiProductsCat?.groups.reduce((n, g) => n + g.items.length, 0) || 0;
FILTERS[2].count = aiCount;

// Interactive
if (interactiveCat) {
  FILTERS[3].count = interactiveCat.groups.reduce((n, g) => n + g.items.length, 0);
}

// Tools = ai-tools only
if (aiToolsCat) {
  FILTERS[4].count = aiToolsCat.groups.reduce((n, g) => n + g.items.length, 0);
}
---
<Site
  title="Work — Takao Umehara"
  description="Complete portfolio of interactive experiences, AI products, and design work by Takao Umehara"
  canonical="https://takaoumehara.com/work"
  bodyClass="work-fullscreen"
>
  <main class="work-page-full" data-category="work">
    <header class="work-header">
      <div class="work-header-top">
        <!-- The same masthead as the landing's rail: the name (home link), then
             one mono line of what is indexed and the title line. No "← Home". -->
        <div class="work-brand">
          <a class="side-wordmark work-wordmark" href="/">{profile.name}</a>
          <p class="work-status">
            <span class="t-en">Index · {FILTERS[0].count} Works</span><span class="t-jp" lang="ja">索引・全 {FILTERS[0].count} 作品</span>
          </p>
          <p class="work-tagline" set:html={t(profile.tagline)} />
          <nav class="work-nav" aria-label="Site">
            <a href="/"><span class="t-en">Home</span><span class="t-jp" lang="ja">ホーム</span></a>
            <a href="/about"><span class="t-en">About</span><span class="t-jp" lang="ja">について</span></a>
            <a href="/about#work-with-me"><span class="t-en">Contact</span><span class="t-jp" lang="ja">相談</span></a>
            <a href="/takao-umehara-resume.pdf" target="_blank" rel="noopener"><span class="t-en">Resume (PDF)</span><span class="t-jp" lang="ja">履歴書 (PDF)</span></a>
            <a href={profile.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          </nav>
        </div>
        <div class="work-controls">
          <button class="work-search-btn" id="work-search-toggle" type="button" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="8" cy="8" r="6"/>
              <path d="M13 13l5 5"/>
            </svg>
          </button>
          <button class="side-theme" data-theme-switch="true" type="button" role="switch" aria-checked="false" aria-label="Dark mode"></button>
          <button class="side-lang" data-lang-cycle="true" type="button" aria-label="Switch to Japanese">JP</button>
        </div>
      </div>
      
      <div class="work-search-panel" id="work-search-panel" hidden>
        <input 
          type="search" 
          class="work-search-input" 
          id="work-search-input"
          placeholder="Search work…"
          data-placeholder-en="Search work…"
          data-placeholder-jp="作品を検索…"
        />
      </div>
      
      <div class="work-filters" role="group" aria-label="Filter work by discipline">
        {FILTERS.map((f, i) => (
          <button type="button" class={`filter-btn${i === 0 ? " is-active" : ""}`} data-filter={f.id}>
            <span set:html={t(f.label)} />
            <span class="filter-count">{f.count}</span>
          </button>
        ))}
      </div>
    </header>

    <div class="work-bento" id="work-bento">
      {tiles.map(({ item, category, to, stamp, size, meta }) => (
        <article
          class={`tile tile--${size} cat-card grid-card bento-cell`}
          id={item.slug}
          data-href={to ? to.url : undefined}
          data-external={to?.external ? "true" : undefined}
          data-category={category}
          tabindex={to ? "0" : undefined}
        >
          <div class="tile-media" set:html={mediaFill(item)} />
          {stamp && <span class="input-stamp">{stamp}</span>}
          <div class="tile-body">
            <h3 class="cat-card-title tile-title" set:html={cardName(item)} />
            {meta && <p class="tile-meta" set:html={meta} />}
            <p class="cat-card-desc tile-desc" set:html={tb(item.cardLine ?? item.summary)} />
          </div>
          {to && (
            <a
              class="cat-card-cta"
              href={to.url}
              target={to.external ? "_blank" : undefined}
              rel={to.external ? "noopener" : undefined}
            >
              <span class="sr-only" set:html={t(to.label)} />
            </a>
          )}
        </article>
      ))}
    </div>

    <ContactCta />
  </main>
</Site>

<style>
  /* The rail is dropped and the shell collapses to one column in
     src/styles/shell.css (body.work-fullscreen), so those rules survive a
     View Transitions swap. This page then runs the full viewport. */
  .work-page-full {
    width: 100%;
    padding: clamp(24px, 3vw, 56px) var(--gutter);
  }

  .work-header {
    margin-bottom: 40px;
  }

  .work-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }

  .work-header-top { align-items: flex-start; }
  .work-brand { min-width: 0; }
  .work-wordmark { color: var(--ink); text-decoration: none; }
  .work-status {
    margin: var(--sp-3) 0 0;
    font-family: var(--ff-mono); font-weight: var(--fw-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono); color: var(--pr-ink-2); font-variant-numeric: tabular-nums;
  }
  .work-tagline { margin: 6px 0 0; font-size: var(--text-sm); color: var(--pr-ink-2); max-width: 60ch; }
  /* Ways back out of the full-width index (no rail here): plain text links
     in the filter tabs' voice. On touch each gets a 44px-tall hit area. */
  .work-nav { display: flex; flex-wrap: wrap; column-gap: var(--sp-3); margin: var(--sp-2) 0 0; }
  .work-nav a {
    display: inline-flex; align-items: center; min-height: 28px;
    font-size: var(--text-sm); color: var(--pr-ink-2); text-decoration: none;
  }
  .work-nav a:hover, .work-nav a:focus-visible { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px), (pointer: coarse) {
    .work-nav a { min-height: 44px; }
  }
  
  .work-controls {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  
  /* The chrome matches the rail's controls: a grey disc, no hairline. */
  .work-search-btn {
    appearance: none;
    border: 0;
    border-radius: 50%;
    background: var(--pr-card);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--ink);
    transition: background 140ms ease;
  }

  .work-search-btn:hover {
    background: var(--pr-card-2);
  }

  .work-search-panel {
    margin-bottom: 24px;
    animation: slideDown 0.2s ease;
  }

  .work-search-input {
    width: 100%;
    padding: 12px var(--sp-3);
    font-size: var(--text-body);
    border: 1px solid var(--pr-line);
    border-radius: var(--r-pill);
    background: var(--pr-card);
    color: var(--ink);
    font-family: inherit;
  }

  .work-search-input:focus {
    outline: none;
    border-color: var(--pr-blue);
    background: var(--pr-canvas);
  }

  /* Same gutter as the grid below it (src/styles/grid.css). */
  .work-filters {
    display: flex;
    gap: var(--gap-grid);
    flex-wrap: wrap;
  }

  /* Plain text tabs, not boxed pills: the active discipline is ink and
     underlined, the rest one ink step quieter; the count is a mono
     superscript, like the rail's index line. */
  .work-filters { gap: var(--sp-3); }
  .work-page-full .filter-btn {
    appearance: none; border: 0; border-radius: 0; background: none;
    min-height: 32px; padding: 4px 0;
    font-size: var(--text-md); color: var(--pr-ink-2);
    display: inline-flex; align-items: flex-start; gap: 4px;
    text-decoration: none;
  }
  .work-page-full .filter-btn:hover { background: none; color: var(--ink); }
  .work-page-full .filter-btn.is-active {
    background: none; color: var(--ink);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px;
  }
  /* Touch: each tab is at least a 44px square hit area. */
  @media (max-width: 900px), (pointer: coarse) {
    .work-page-full .filter-btn { min-height: 44px; min-width: 44px; align-items: center; }
  }
  .work-page-full .filter-count,
  .work-page-full .filter-btn.is-active .filter-count {
    font-family: var(--ff-mono); font-size: 10px; line-height: 1; color: inherit; opacity: 1;
    font-variant-numeric: tabular-nums; transform: translateY(2px);
  }

  /* ── The free grid ──────────────────────────────────────────────────────
     A "fairly free" bento, not the fixed 3-column PORTO ROCHA grid every
     other page uses: a base tile is 1x1, some are "wide" (2x1) and a few are
     "feature" (2x2) — src/pages/work.astro's SIZE_CYCLE assigns the class
     deterministically, opening on Interactive. grid-auto-flow: dense means
     that hiding tiles (the filter bar, the search box, both toggle
     .is-hidden → display:none, the .tile.is-hidden rule below) never leaves a hole:
     the remaining tiles re-pack up into it. */
  .work-bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 220px;
    gap: var(--gap-grid);
    grid-auto-flow: dense;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r);
    background: var(--pr-card);
    grid-column: span 1;
    grid-row: span 1;
  }
  .tile--wide { grid-column: span 2; }
  .tile--feature { grid-column: span 2; grid-row: span 2; }
  /* The filter bar and search box toggle .is-hidden on tiles. The shared
     rule lives in src/styles/grid.css, which this page does not import, so
     the hide rule has to live here too or /work?filter=… shows everything. */
  .tile.is-hidden { display: none !important; }
  .tile-media {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    background: var(--pr-card-2);
  }
  .tile-media img,
  .tile-media video,
  .tile-media .card-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms cubic-bezier(.2, .7, .2, 1);
  }
  .tile[data-href]:hover .tile-media img { transform: scale(1.02); }
  .tile-body {
    flex: none;
    padding: var(--cell-pad, clamp(20px, 3vw, 32px));
  }
  .tile-title { margin: 0 0 2px; }
  .tile-meta {
    margin: 0 0 8px;
    font-size: var(--text-xs);
    font-family: var(--ff-mono);
    font-weight: var(--fw-mono);
    color: var(--pr-ink-2);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-mono);
  }
  .tile-desc { margin: 0; }
  .tile--feature .tile-title { font-size: var(--text-lg); }

  /* Tiles with title and meta always visible on all devices. On hover/pointer:fine,
     the description fades in over the bottom. On touch (no hover), description
     stays visible below the title/meta. */
  @media (hover: hover) and (pointer: fine) {
    .tile-body {
      position: absolute; left: 8px; right: 8px; bottom: 8px; z-index: 3;
      padding: 12px 16px; border-radius: calc(var(--r) - 2px);
      background: var(--pr-canvas); color: var(--ink);
      pointer-events: none;
    }
    /* Hide description on hover devices by default */
    .tile-desc {
      max-height: 0; opacity: 0; transform: translateY(6px); pointer-events: none; overflow: hidden;
      transition: max-height 180ms var(--ease-decel, ease-out), opacity 180ms var(--ease-decel, ease-out), transform 180ms var(--ease-decel, ease-out);
    }
    .tile .input-stamp {
      opacity: 0; transition: opacity 180ms var(--ease-decel, ease-out);
    }
    /* On hover/focus, show description */
    .tile:hover .tile-desc, .tile:focus-within .tile-desc, .tile:focus-visible .tile-desc,
    .tile:hover .input-stamp, .tile:focus-within .input-stamp, .tile:focus-visible .input-stamp {
      max-height: 200px; opacity: 1; transform: none;
    }
    .tile--feature .tile-title { font-size: var(--text-md); }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .tile-desc, .tile .input-stamp { transition: none; transform: none; }
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @media (max-width: 768px) {
    .work-page-full {
      padding: 24px var(--gutter);
    }

    .work-filters {
      gap: 8px;
    }

    .work-page-full .filter-btn { font-size: var(--text-body); }

    /* Fewer columns, and a feature/wide tile only doubles width, never
       height — a 2x2 square at 2 columns wide would run the whole first
       screen. */
    .work-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 200px;
    }
    .tile--feature { grid-row: span 1; }
  }

  /* One column, no horizontal scroll: every tile (feature and wide included)
     is full width, stacked. */
  @media (max-width: 480px) {
    .work-bento {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 240px;
    }
    .tile--wide,
    .tile--feature {
      grid-column: span 1;
    }
  }
</style>

<script>
  // Filter functionality
  (() => {
    const btns = document.querySelectorAll(".work-page-full .filter-btn");
    const cards = document.querySelectorAll(".work-page-full .cat-card[data-category]");
    if (!btns.length || !cards.length) return;
    
    // Map simplified filters to original category slugs
    // Each project belongs to exactly ONE non-All filter
    const filterMap = {
      'all': () => true,
      'product': (cats) => cats.includes('brand') || cats.includes('work'),
      'ai': (cats) => cats.includes('ai-products'),
      'interactive': (cats) => cats.includes('interactive'),
      'tools': (cats) => cats.includes('ai-tools')
    };

    function applyFilter(filter) {
      btns.forEach((b) => b.classList.toggle("is-active", b.dataset.filter === filter));
      const matcher = filterMap[filter];
      cards.forEach((card) => {
        const cats = (card.dataset.category || "").split(" ");
        const show = matcher(cats);
        card.classList.toggle("is-hidden", !show);
      });
      try {
        if (filter !== "all") history.replaceState(null, "", "#" + filter);
        else if (window.location.hash) history.replaceState(null, "", window.location.pathname);
      } catch (e) {}
    }

    btns.forEach((b) => b.addEventListener("click", () => applyFilter(b.dataset.filter)));

    // Either form opens a discipline: #design, or ?filter=design, which is what
    // vercel.json sends the old category addresses to.
    const params = new URLSearchParams(window.location.search);
    const requested = (params.get("filter") || window.location.hash.replace("#", "")).toLowerCase();
    if (requested && filterMap[requested]) {
      applyFilter(requested);
    }
  })();
  
  // Search toggle
  (() => {
    const toggle = document.getElementById("work-search-toggle");
    const panel = document.getElementById("work-search-panel");
    const input = document.getElementById("work-search-input");
    
    if (!toggle || !panel || !input) return;
    
    toggle.addEventListener("click", () => {
      const isHidden = panel.hasAttribute("hidden");
      if (isHidden) {
        panel.removeAttribute("hidden");
        input.focus();
      } else {
        panel.setAttribute("hidden", "");
        input.value = "";
        // Clear search filter
        document.querySelectorAll(".work-page-full .cat-card").forEach(c => {
          c.style.display = "";
        });
      }
    });
    
    // Simple search
    input.addEventListener("input", (e) => {
      const query = e.target.value.toLowerCase();
      const cards = document.querySelectorAll(".work-page-full .cat-card");
      cards.forEach((card) => {
        const text = card.textContent.toLowerCase();
        card.style.display = text.includes(query) ? "" : "none";
      });
    });
  })();
</script>
