import FragmentPage from "../components/FragmentPage.astro";
import body from "../fragments/publications.html?raw";
import css from "../fragments/publications.css?raw";
import meta from "../fragments/publications.json";
---
<FragmentPage meta={meta} body={body} css={css} current="/publications.html" />
