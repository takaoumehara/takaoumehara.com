---
// The About page: consolidates every page that used to be about the person —
// about.html, publications.html, workshop.html, work-with-me.html and
// contact.html (src/fragments/*, the pre-Astro static site) plus src/data/now.json
// and src/data/profile.json — into one page, laid out as a bento: every
// section is one or more cells (.about-cell.bento-cell), each carrying the
// site's one inner padding (--cell-pad) so every piece of text lines up with
// the work grid and the detail page. Every fact below is carried over
// unchanged from those sources (docs/superforge.md: never invent numbers).
//
// Sections: #intro (hero + stats), organizations, #experience, #now,
// #writing, #workshops, #work-with-me, #studio. vercel.json redirects the
// old standalone addresses (/now, /publications, /workshop, /work-with-me,
// /studio, /contact) to these anchors — keep them.
//
// The rail: this page used to hide the left rail (body.about-page .side {
// display: none }, right below). That local override is removed here per
// the person's request ("About... show them here in the same bento-box
// style" — i.e. inside the normal shell, rail included). src/styles/shell.css
// (agent B's file) also collapses the shell to one column and hides .side
// for body.about-page — that rule has to go too, or the rail stays hidden
// regardless of this file. Flagged in this round's report.
import Site from "../layouts/Site.astro";
import { t, tb } from "../lib/html.mjs";
import { getLibrary, destination } from "../lib/site.mjs";

const lib = getLibrary();
const profile = lib.profile;
const extraordinary = lib.evidence.get("extraordinary");
const bookLink = extraordinary ? destination(extraordinary) : null;
---
<Site
  title="About — Takao Umehara"
  description="Design & AI Executive building interactive experiences and the environments teams ship in."
  canonical="https://takaoumehara.com/about"
  bodyClass="about-page"
>
  <main class="cat-page about-content" data-category="about">
    <div class="about-bento">

      <!-- Hero: portrait, role line, H1, bio — one cell, per the shared bento rule -->
      <section id="intro" class="about-cell bento-cell cell-hero">
        <div class="about-hero-grid">
          <div class="about-hero-copy">
            <p class="about-role">
              <span class="t-en">Design &amp; AI Executive · 0→1 Product &amp; Experience Builder</span>
              <span class="t-jp">Design &amp; AI Executive · 0→1 Product &amp; Experience Builder</span>
            </p>
            <h1 class="about-h1">
              <span class="t-en">I do my best work before the answer is obvious.</span>
              <span class="t-jp">答えがまだ見えないうちに、いちばん良い仕事をする。</span>
            </h1>
            <p class="about-subtitle">
              <span class="t-en">Design & AI Executive — building interactive experiences and the environments teams ship in.</span>
              <span class="t-jp">Design & AI Executive — インタラクティブ体験と、チームが届ける環境をつくる。</span>
            </p>

            <p class="about-bio">
              <span class="t-en">Based between New York and Japan. Twenty-plus years taking products from 0→1 — not only Figma files, but the AI-ready environments teams actually build and ship in.</span>
              <span class="t-jp">ニューヨークと日本を拠点に。20年以上、0→1 のプロダクトづくりに携わる。Figma だけではない。チームが実際にビルドし届ける、AI 前提の環境まで設計する。</span>
            </p>
            <p class="about-bio about-bio-2">
              <span class="t-en">I work at the beginning of things — finding possibilities, connecting disciplines that are usually kept separate, and turning ambiguous ideas into products, experiences, ventures and systems people can actually react to.</span>
              <span class="t-jp">僕がいちばん力を出せるのは、「何をつくるか」がまだはっきり決まっていない段階です。まだ見えていない可能性を見つけて、一見関係のないものをつなぎ、人が触ったり試したりできるところまで持っていく。</span>
            </p>
          </div>
          <figure class="about-portrait">
            <img src="/assets/about/TakaoUmehara_passport.png" alt="Takao Umehara" width="1024" height="1024" loading="eager" />
          </figure>
        </div>
      </section>

      <!-- Stats -->
      <section class="about-cell bento-cell cell-stats">
        <div class="about-stats">
          <div class="stat-item">
            <div class="stat-value">20+</div>
            <div class="stat-label">
              <span class="t-en">Years</span>
              <span class="t-jp">年</span>
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-value">40+</div>
            <div class="stat-label">
              <span class="t-en">Verizon designers supported by AI workflows</span>
              <span class="t-jp">Verizon — AI ワークフローで支援したデザイナー</span>
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-value">20</div>
            <div class="stat-label">
              <span class="t-en">SOSV founders mentored</span>
              <span class="t-jp">SOSV — メンタリングした創業者</span>
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-value">11K+</div>
            <div class="stat-label">
              <span class="t-en">Extra Ordinary book copies sold</span>
              <span class="t-jp">Extra Ordinary — 販売部数</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Selected organizations — from the old about.html's "Notable Organizations" section -->
      <section class="about-cell bento-cell cell-orgs">
        <h2 class="about-h2">
          <span class="t-en">Selected organizations</span>
          <span class="t-jp">協働した主な企業・機関</span>
        </h2>
        <div class="org-badges">
          <span class="org-badge">Amplify Education</span>
          <span class="org-badge">Verizon</span>
          <span class="org-badge">T-Mobile</span>
          <span class="org-badge">Coca-Cola</span>
          <span class="org-badge">School of Visual Arts (SVA)</span>
          <span class="org-badge">SOSV</span>
          <span class="org-badge">USAA</span>
          <span class="org-badge">Carnegie Foundation</span>
          <span class="org-badge">Tokyo Metropolitan Government</span>
          <span class="org-badge">Emerson Collective</span>
          <span class="org-badge">Google (training)</span>
          <span class="org-badge">Microsoft (training)</span>
          <span class="org-badge">Tiffany &amp; Co. (training)</span>
          <span class="org-badge">Dentsu</span>
        </div>
      </section>

      <!-- Experience: the career timeline, from the old about.html -->
      <section id="experience" class="about-cell bento-cell cell-experience">
        <h2 class="about-h2">
          <span class="t-en">Experience</span>
          <span class="t-jp">経歴</span>
        </h2>
        <ul class="timeline-list">
          <li class="timeline-item">
            <p class="timeline-role">
              <span class="t-en"><strong>Creativity Is Everywhere LLC</strong> — Executive Creative Director / Founder (2020–Present)</span>
              <span class="t-jp"><strong>Creativity Is Everywhere LLC</strong> — エグゼクティブ・クリエイティブディレクター / 代表（2020年〜現在）</span>
            </p>
            <p class="timeline-desc">
              <span class="t-en">Leading a specialized studio partnering with ventures and enterprises across the US and Japan — AI product strategy, brand architecture and 0→1 venture creation for clients including T-Mobile, Emerson Collective, and the Tokyo Metropolitan Government.</span>
              <span class="t-jp">日米の企業やスタートアップと協働するクリエイティブスタジオを主宰。T-Mobile、Emerson Collective、東京都などのプロダクト設計、ブランド構築、AI 戦略を推進。</span>
            </p>
          </li>
          <li class="timeline-item">
            <p class="timeline-role">
              <span class="t-en"><strong>Verizon</strong> — Design &amp; AI Workflow Lead (2024–Present)</span>
              <span class="t-jp"><strong>Verizon</strong> — デザイン &amp; AI ワークフロー・リード（2024年〜現在）</span>
            </p>
            <p class="timeline-desc">
              <span class="t-en">Leading AI workflow transformation across product design organizations — enabling 40+ designers and 80+ cross-functional partners to adopt generative tools, agentic prototypes and scalable design systems.</span>
              <span class="t-jp">プロダクトデザイン組織における AI ワークフロー変革を主導。40名以上のデザイナーと80名以上のステークホルダーが自律型プロトタイピングや生成ツールを活用できる仕組みを構築。</span>
            </p>
          </li>
          <li class="timeline-item">
            <p class="timeline-role">
              <span class="t-en"><strong>School of Visual Arts (SVA)</strong> — Adjunct Professor, Graphic Design (2024)</span>
              <span class="t-jp"><strong>SVA</strong> — 非常勤教授・グラフィックデザイン学科（2024年）</span>
            </p>
            <p class="timeline-desc">
              <span class="t-en">Taught Advanced Typography — mentored BFA students in modern type systems, digital kinetic layouts, and contemporary graphic rigor in New York City.</span>
              <span class="t-jp">ニューヨーク本校にてアドバンスド・タイポグラフィを担当。現代のタイポグラフィ体系と動的表現を指導。</span>
            </p>
          </li>
          <li class="timeline-item">
            <p class="timeline-role">
              <span class="t-en"><strong>SOSV</strong> — Startup Coach, Product Design &amp; Branding (2019–2020)</span>
              <span class="t-jp"><strong>SOSV</strong> — スタートアップコーチ・プロダクトデザイン &amp; ブランディング（2019〜2020年）</span>
            </p>
            <p class="timeline-desc">
              <span class="t-en">Coached 20 founders of Food and Blockchain seed-stage startups on customer discovery, UX strategy, identity design and go-to-market storytelling.</span>
              <span class="t-jp">フードテックおよびブロックチェーン分野の創業者20名に対し、ユーザー体験設計、ブランド構築、事業立ち上げ時の実践的ガイダンスを提供。</span>
            </p>
          </li>
          <li class="timeline-item">
            <p class="timeline-role">
              <span class="t-en"><strong>Concentrix Catalyst</strong> — Lead Product Designer (2020–2021)</span>
              <span class="t-jp"><strong>Concentrix Catalyst</strong> — リードプロダクトデザイナー（2020〜2021年）</span>
            </p>
            <p class="timeline-desc">
              <span class="t-en">Architected a major US banking portal spanning 105 screens, full design system tokens, and self-service servicing for cardholders nationwide.</span>
              <span class="t-jp">全米大手銀行のクレジットカードポータルを設計。105画面のUI、網羅的なデザインシステム、強固なアクセシビリティを策定。</span>
            </p>
          </li>
          <li class="timeline-item">
            <p class="timeline-role">
              <span class="t-en"><strong>Amplify Education</strong> — Product Design Lead / Design Strategy Coach (2013–2020)</span>
              <span class="t-jp"><strong>Amplify Education</strong> — プロダクトデザインリード / デザイン戦略コーチ（2013〜2020年）</span>
            </p>
            <p class="timeline-desc">
              <span class="t-en">Spearheaded 10+ ELA Quests releases, combining narrative storytelling, gamified mechanics and educational standards into learning apps used daily by millions of US students.</span>
              <span class="t-jp">ELA Quests シリーズ10作以上のプロダクト立ち上げを主導。物語とゲーム性、学習指導要領を融合し、全米数百万人の児童・生徒が利用する教育基盤を構築。</span>
            </p>
          </li>
          <li class="timeline-item">
            <p class="timeline-role">
              <span class="t-en"><strong>Ogilvy Brand Integration Group (BIG)</strong> — Senior Designer (2007–2008)</span>
              <span class="t-jp"><strong>Ogilvy BIG</strong> — シニアデザイナー（2007〜2008年）</span>
            </p>
            <p class="timeline-desc">
              <span class="t-en">Collaborated on Coca-Cola's worldwide visual identity refresh — global visual guidelines, packaging principles and cross-medium brand applications.</span>
              <span class="t-jp">コカ・コーラのグローバル・リブランディングにおいて、世界各国のパッケージングや広告展開を統一するブランドガイドラインの策定に従事。</span>
            </p>
          </li>
        </ul>
      </section>

      <!-- Now -->
      <section id="now" class="about-cell bento-cell cell-now">
        <h2 class="about-h2">
          <span class="t-en">Now</span>
          <span class="t-jp">いま</span>
        </h2>
        <ul class="about-list">
          <li>
            <span class="t-en">Shipping <strong>Intent First</strong> — thesis and practice for Context Grammar: helping AI read intent, not just prompts.</span>
            <span class="t-jp"><strong>Intent First</strong> — Context Grammar の主張と実践。AI がプロンプトではなく意図を読むための語彙。</span>
          </li>
          <li>
            <span class="t-en">Building <strong>moime</strong> — phone-first pages that start from finished design.</span>
            <span class="t-jp"><strong>moime</strong> — 完成したデザインから始まる、スマホ前提のページづくり。</span>
          </li>
          <li>
            <span class="t-en">Releasing interactive works (Typespace, Resona, and late-summer playables).</span>
            <span class="t-jp">インタラクティブ作品の公開（Typespace、Resona、晩夏のプレイアブル）。</span>
          </li>
          <li>
            <span class="t-en">Teaching / coaching AI skills for design and product teams.</span>
            <span class="t-jp">デザイン／プロダクトチーム向けの AI スキル指導・コーチング。</span>
          </li>
          <li>
            <span class="t-en">Selective studio and hiring conversations.</span>
            <span class="t-jp">スタジオ案件および採用の対話（厳選）。</span>
          </li>
        </ul>
      </section>

      <!-- Writing -->
      <section id="writing" class="about-cell bento-cell cell-writing">
        <h2 class="about-h2">
          <span class="t-en">Writing</span>
          <span class="t-jp">文章</span>
        </h2>
        <div class="writing-cards">
          <a href="https://intentfirst.substack.com" target="_blank" rel="noopener" class="writing-card">
            <h3 class="writing-title">Intent First</h3>
            <p class="writing-excerpt">
              <span class="t-en">Why dissolving the last brief is the real first step.</span>
              <span class="t-jp">前回のブリーフを溶かすことが、本当の第一歩になる理由。</span>
            </p>
            <span class="writing-link">
              <span class="t-en">Read on Substack →</span>
              <span class="t-jp">Substack で読む →</span>
            </span>
          </a>
          <a href="https://breakbias.medium.com" target="_blank" rel="noopener" class="writing-card">
            <h3 class="writing-title">Break Bias</h3>
            <p class="writing-excerpt">
              <span class="t-en">Notes on seeing past default taste in product and culture.</span>
              <span class="t-jp">プロダクトと文化のなかの「既定の好み」を見抜くノート。</span>
            </p>
            <span class="writing-link">
              <span class="t-en">Read on Medium →</span>
              <span class="t-jp">Medium で読む →</span>
            </span>
          </a>
          {bookLink && (
            <a href={bookLink.url} class="writing-card">
              <h3 class="writing-title">extra•ordinary</h3>
              <p class="writing-excerpt" set:html={tb(extraordinary.summary)} />
              <span class="writing-link" set:html={t(bookLink.label)} />
            </a>
          )}
        </div>
      </section>

      <!-- Workshops -->
      <section id="workshops" class="about-cell bento-cell cell-workshops">
        <h2 class="about-h2">
          <span class="t-en">Workshops</span>
          <span class="t-jp">ワークショップ</span>
        </h2>
        <p class="about-text">
          <span class="t-en">Short intensives on interactive craft + AI build environments (not prompt theater).</span>
          <span class="t-jp">インタラクティブの手仕事と、AI 前提のビルド環境についての短期集中（プロンプト劇ではない）。</span>
        </p>
        <p class="about-text">
          <span class="t-en">Team workshops — from taste judgment to shippable prototypes.</span>
          <span class="t-jp">チーム向け — 審美判断から、届けられるプロトタイプまで。</span>
        </p>
        <ul class="about-list about-list--tight">
          <li><span class="t-en">For new ventures</span><span class="t-jp">新規事業・0→1</span></li>
          <li><span class="t-en">For product &amp; innovation teams</span><span class="t-jp">プロダクト・イノベーションチーム</span></li>
          <li><span class="t-en">For creative challenges</span><span class="t-jp">クリエイティブ課題解決</span></li>
          <li><span class="t-en">For leadership teams</span><span class="t-jp">経営・リーダーシップ層</span></li>
        </ul>
        <p class="about-cta">
          <a href="#work-with-me" class="about-link">
            <span class="t-en">Ask about a workshop →</span>
            <span class="t-jp">ワークショップについて問い合わせる →</span>
          </a>
        </p>
      </section>

      <!-- Work with me -->
      <section id="work-with-me" class="about-cell bento-cell cell-work-with-me">
        <h2 class="about-h2">
          <span class="t-en">Work with me</span>
          <span class="t-jp">仕事の相談</span>
        </h2>
        <p class="about-text">
          <span class="t-en">Hiring and studio. I help teams and founders when the brief is still soft — interactive experiences, AI product surfaces, and the systems around them.</span>
          <span class="t-jp">採用とスタジオ。ブリーフがまだ柔らかい段階で、チームと創業者を支援する — インタラクティブ体験、AI プロダクトの表層、その周りの仕組みまで。</span>
        </p>
        <ul class="about-list about-list--tight">
          <li><span class="t-en">Full-time / leadership roles</span><span class="t-jp">フルタイム / リーダーシップ</span></li>
          <li><span class="t-en">Fractional / advisory</span><span class="t-jp">顧問 / フラクショナル</span></li>
          <li><span class="t-en">0→1 product &amp; technology collaboration</span><span class="t-jp">0→1 プロダクト &amp; 技術協業</span></li>
          <li><span class="t-en">Speaking / workshops</span><span class="t-jp">講演 / ワークショップ</span></li>
        </ul>
        <p class="about-contact">
          <span class="t-en">Reach: </span>
          <span class="t-jp">連絡先: </span>
          <a href="mailto:takaoumehara@gmail.com" class="about-email">takaoumehara@gmail.com</a>
        </p>
      </section>

      <!-- Studio -->
      <section id="studio" class="about-cell bento-cell cell-studio">
        <h2 class="about-h2">Studio</h2>
        <p class="about-studio-tagline">Creativity is Everywhere.</p>
        <p class="about-text">
          <span class="t-en">Studio practice under a simple company sentence: Takao Umehara's independent design & AI studio (LLC) — selective collaborations, not an agency mill.</span>
          <span class="t-jp">独立した Design & AI スタジオ（LLC）としての一文：選抜したコラボレーション。量産エージェンシーではない。</span>
        </p>
        <p class="about-cta">
          <a href={profile.studio.url} target="_blank" rel="noopener" class="about-link">
            <span class="t-en">Visit studio site →</span>
            <span class="t-jp">スタジオサイトへ →</span>
          </a>
        </p>
      </section>

      <!-- Footer links -->
      <section class="about-cell bento-cell cell-footer">
        <a href="/" class="about-footer-link">← <span class="t-en">Home</span><span class="t-jp">ホーム</span></a>
        <a href="/work" class="about-footer-link"><span class="t-en">All Work</span><span class="t-jp">すべての作品</span> →</a>
      </section>

    </div>
  </main>
</Site>

<style is:inline>
  .about-content {
    width: 100%;
  }

  /* The bento: a 12-column base so a cell can be full width, a half (career /
     now, workshops / work-with-me) or anything in between. One column below
     900px — the same width every other stacked page collapses to. */
  .about-bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap-grid);
  }

  .about-cell {
    grid-column: span 12;
    background: var(--pr-card);
    border-radius: var(--r);
    padding: var(--cell-pad, clamp(20px, 3vw, 32px));
  }
  /* The hero and the footer read better with no fill — canvas, not card grey
     — but the padding (docs/superforge.md's bento rule) is the same either
     way: a cell may be visually invisible and still keep its inner padding. */
  .cell-hero, .cell-footer { background: none; padding-left: 0; padding-right: 0; }

  .cell-experience { grid-column: span 7; }
  .cell-now { grid-column: span 5; }
  .cell-workshops { grid-column: span 6; }
  .cell-work-with-me { grid-column: span 6; }

  .cell-footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(200px, 0.6fr);
    gap: clamp(32px, 5vw, 56px);
    align-items: start;
  }

  .about-role {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink-mid);
    margin-bottom: 12px;
  }

  .about-portrait {
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-raised, var(--pr-card));
    border: 1px solid var(--border);
    margin: 0;
  }

  .about-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 24px;
  }

  .about-subtitle {
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-mid);
    margin-bottom: 32px;
  }

  .about-bio {
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 20px;
  }
  .about-bio-2 { margin-bottom: 0; }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 32px;
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 36px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-dim);
  }

  .org-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .org-badge {
    font-size: 13px;
    color: var(--ink-mid);
    background: var(--pr-card-2);
