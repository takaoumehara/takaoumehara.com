---
// Unified project detail page using Porto Rocha-style template
// Generates detail pages for ALL projects/experiments with case studies
import Site from "../../layouts/Site.astro";
import ProjectDetail from "../../components/project/ProjectDetail.astro";
import { getLibrary, evidenceForCaseStudy } from "../../lib/site.mjs";

export async function getStaticPaths() {
  const lib = getLibrary();
  const htmlFiles = import.meta.glob("../../case-studies/*.html", { query: "?raw", import: "default", eager: true });
  const cssFiles = import.meta.glob("../../case-studies/*.css", { query: "?raw", import: "default", eager: true });
  const jsonFiles = import.meta.glob("../../case-studies/*.json", { eager: true, import: "default" });
  const slugOf = (path: string) => path.split("/").pop()!.replace(/\.\w+$/, "");

  const paths = [];
  
  // Generate from existing case studies
  for (const path of Object.keys(htmlFiles)) {
    const slug = slugOf(path);
    const item = evidenceForCaseStudy(slug);
    if (item) {
      paths.push({
        params: { slug },
        props: {
          item,
          body: htmlFiles[path],
          css: cssFiles[path.replace(/\.html$/, ".css")],
          meta: jsonFiles[path.replace(/\.html$/, ".json")],
        },
      });
    }
  }
  
  // Track which slugs already have paths
  const existingSlugs = new Set(paths.map(p => p.params.slug));
  
  // Generate for ALL evidence items, prioritizing those with caseStudy links or in main categories
  for (const [slug, item] of lib.evidence.entries()) {
    // Skip if already generated
    if (existingSlugs.has(slug)) continue;
    
    // Check if item has explicit caseStudy link
    let targetSlug = slug;
    if (item.links?.caseStudy) {
      targetSlug = item.links.caseStudy.replace(/^projects\//, "").replace(/\.html$/, "");
    }
    
    // Skip if target slug already exists
    if (existingSlugs.has(targetSlug)) continue;
    
    // Generate page for this item
    existingSlugs.add(targetSlug);
    
    // Determine theme and description
    const theme = item.kind === 'experiment' ? 'dark' : 'light';
    const description = typeof item.summary === 'string' 
      ? item.summary 
      : item.summary?.en || item.cardLine?.en || "";
    
    // Extract challenge and solution for bento
    const challenge = item.challenge || (item.contribution?.challenges?.[0] 
      ? { en: item.contribution.challenges[0], jp: item.contribution.challenges[0] }
      : null);
    
    const solution = item.solution || (item.contribution?.mine?.[0]
      ? { en: item.contribution.mine[0], jp: item.contribution.mine[0] }
      : null);
    
    paths.push({
      params: { slug: targetSlug },
      props: {
        item: {
          ...item,
          challenge: challenge,
          solution: solution,
        },
        body: null,
        css: null,
        meta: {
          title: `${item.title} — Takao Umehara`,
          description,
          theme,
        },
      },
    });
  }

  return paths;
}

const { slug } = Astro.params;
const { item, body, css, meta } = Astro.props;
const current = `/projects/${slug}.html`;
const canonical = meta?.canonical ?? `https://takaoumehara.com${current}`;

// Check if item has video preview for teaser
const videoUrl = item?.assets?.preview?.mp4 || item?.assets?.preview?.webm;
const videoAudioRecommended = item?.playable && videoUrl;
---
<Site
  title={meta?.title || `${item?.title} — Takao Umehara`}
  description={meta?.description || ""}
  canonical={canonical}
  ogImage={meta?.ogImage || item?.assets?.hero}
  ogType={meta?.ogType || "article"}
  theme={meta?.theme}
  htmlClass={meta?.htmlClass}
  bodyClass={meta?.bodyClass}
  current={current}
  stylesheets={meta?.stylesheets}
  style={css}
  fonts={meta?.fonts}
>
  <main class="project-page">
    <ProjectDetail 
      item={item} 
      body={body}
      videoUrl={videoUrl}
      videoAudioRecommended={videoAudioRecommended}
    />
  </main>
</Site>

<style>
  .project-page {
    padding-top: 40px;
  }
  
  @media (max-width: 768px) {
    .project-page {
      padding-top: 24px;
    }
  }
</style>
