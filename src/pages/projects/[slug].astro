---
// One route for every case study, built from src/case-studies/<slug>.{html,css,json}
// (see scripts/extract-page.mjs). build.format: 'file' turns this into
// /projects/<slug>.html — the same URL the hand-built pages always had.
//
// import.meta.glob() and the plain `const`s that read it are called INSIDE
// getStaticPaths() and handed down through `props`, not read from module
// scope in the page body below: Astro runs getStaticPaths() in its own
// isolated pass to build the route manifest, and a module-scope binding
// referenced only from inside that function comes back "is not defined" —
// props are the documented way around it.
import FragmentPage from "../../components/FragmentPage.astro";

export async function getStaticPaths() {
  const htmlFiles = import.meta.glob("../../case-studies/*.html", { query: "?raw", import: "default", eager: true });
  const cssFiles = import.meta.glob("../../case-studies/*.css", { query: "?raw", import: "default", eager: true });
  const jsonFiles = import.meta.glob("../../case-studies/*.json", { eager: true, import: "default" });
  const slugOf = (path: string) => path.split("/").pop()!.replace(/\.\w+$/, "");

  return Object.keys(htmlFiles).map((path) => {
    const slug = slugOf(path);
    return {
      params: { slug },
      props: {
        body: htmlFiles[path],
        css: cssFiles[path.replace(/\.html$/, ".css")],
        meta: jsonFiles[path.replace(/\.html$/, ".json")],
      },
    };
  });
}

const { slug } = Astro.params;
const { body, css, meta } = Astro.props;
---
<FragmentPage meta={meta} body={body} css={css} current={`/projects/${slug}.html`} />
