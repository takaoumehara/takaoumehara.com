---
// The same page as /contact.html, at the URL people link to. The two hand-built
// fragments were byte-identical apart from one extra link (to /try/) and their
// own <title>/description, so they share one bento layout and this page adds
// back exactly that difference.
import BentoDoc from "../components/BentoDoc.astro";
import contact from "../bento/pages/contact.json";

const layout = structuredClone(contact);
layout.seo = {
  ...layout.seo,
  title: "Work With Me — Takao Umehara",
  description: "Explore executive advisory, 0→1 venture collaboration, and prototyping partnership with Takao Umehara.",
  // The hand-built page pointed at "/work-with-me" without ".html". That looks
  // like a typo in the original, but a canonical is a promise to search
  // engines, so the migration keeps it verbatim.
  canonical: "https://takaoumehara.com/work-with-me",
};
// The "01 / Direct Line" cell — the first cell of the channels row.
layout.sections[0].rows[1].cells[0].links.push({
  href: "try/",
  label: {
    en: "Hiring? Paste your posting and see my work arranged for it →",
    jp: "採用担当の方へ: 求人票を貼ると、それに合わせて実績が並び替わります →",
  },
});
---
<BentoDoc layout={layout} current="/work-with-me.html" />
