---
// The Japanese edition of the home page: the same right pane as
// src/pages/index.astro (src/components/home/HomeMain.astro) — only lang and
// canonical differ. "Work" lives at /work (both languages share it).
import Site from "../../layouts/Site.astro";
import HomeMain from "../../components/home/HomeMain.astro";
import { getLibrary, defaultLens } from "../../lib/site.mjs";

const lib = getLibrary();
const lens = defaultLens();
---
<Site
  title={lens.seo.title}
  description={lens.seo.description}
  canonical="https://takaoumehara.com/ja"
  lang="ja"
>
  <HomeMain lib={lib} />
</Site>
