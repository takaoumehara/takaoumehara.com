---
// The Japanese edition of the landing page. Same content, same components as
// src/pages/index.astro — only lang and canonical differ. The switch itself
// (Site.astro) reads lang="ja" and pins to this page.
import Site from "../../layouts/Site.astro";
import Landing from "../../components/landing/Landing.astro";
import { getLibrary, gridEntries, defaultLens } from "../../lib/site.mjs";

const lib = getLibrary();
const lens = defaultLens();
const entries = gridEntries();
---
<Site
  title={lens.seo.title}
  description={lens.seo.description}
  canonical="https://takaoumehara.com/ja"
  lang="ja"
  chrome={false}
  footer={false}
>
  <Landing profile={lib.profile} entries={entries} />
</Site>
