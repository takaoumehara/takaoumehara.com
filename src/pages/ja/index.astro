---
// The Japanese edition of the home page: the same hero slideshow and news
// bento as src/pages/index.astro — only lang and canonical differ. "All
// work" lives at /work (both languages share it). Keep the two files in step.
import Site from "../../layouts/Site.astro";
import HomeHero from "../../components/home/HomeHero.astro";
import HomeNews from "../../components/home/HomeNews.astro";
import { NEWS, SHOWCASE } from "../../data/news.mjs";
import { getLibrary, defaultLens } from "../../lib/site.mjs";

const lib = getLibrary();
const lens = defaultLens();
---
<Site
  title={lens.seo.title}
  description={lens.seo.description}
  canonical="https://takaoumehara.com/ja"
  lang="ja"
>
  <main class="cat-page grid-home" data-category="home">
    <HomeHero lib={lib} order={SHOWCASE} />
    <HomeNews lib={lib} news={NEWS} />
  </main>
</Site>
