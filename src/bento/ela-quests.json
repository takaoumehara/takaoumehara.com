    {
      "label": {
        "en": "Quest 02 — Perception Academy",
        "jp": "Quest 02 — Perception Academy"
      },
      "rows": [
        {
          "h": 4,
          "cells": [
            {
              "kind": "text",
              "w": 6,
              "label": {
                "en": "7th grade · AR learning",
                "jp": "7 年生 · AR"
              },
              "heading": "Perception Academy",
              "body": [
                "Students explore a series of linked activities focusing on brain disorders and how they affect our perception and response to the world. They move through the periods of a school day as though they have one of the perception disorders described in Oliver Sacks's book The Man Who Mistook His Wife for a Hat. AR technology deepened empathy and understanding of neurological conditions."
              ]
            },
