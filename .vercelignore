# Uploaded masters for the Interactive recordings. The site ships the derived
# thumb.jpg / still.jpg / preview.mp4 next to them, never these.
assets/*/masters

# src/ is deployed: the Studio (studio/) imports the engine and the renderer as
# ES modules straight from src/, and the API functions import them too. The
# data is the same public content the pages are rendered from. Pitch material
# (job descriptions of companies applied to) stays out; the samples are shipped.
src/pitches/*
!src/pitches/samples

# Draft-lens previews (node src/build.mjs --preview)
lens/_preview
