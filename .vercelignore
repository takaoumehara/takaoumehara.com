# Build/dev artifacts — not part of the deployed site.
# Patterns are anchored to the repository root: an unanchored "tools" or
# "scripts" also matches src/data/tools and src/scripts (gitignore semantics),
# which stripped records and the site's script before the Vercel build.
/.git
/node_modules
/tests
/test-results
/playwright-report
/docs
/.handoff
/.claude
/tools
/scripts

# Unreferenced raw source footage (not linked from any page).
# Several exceed Vercel's 100 MB per-file limit; mirrors .gitignore.
public/assets/cli-studios/Before_CLI-orginal.mp4
public/assets/cli-studios/After_CLI-newdesign.mp4
public/assets/ela-quests/QUEST-Video_Introducing_Far_From_Home.mp4
public/assets/ela-quests/QUEST-Video_Introducing_The_Robot.mp4
public/assets/ela-quests/QUEST-Video_Perception-short.mp4
public/assets/ela-quests/QUEST-Video_Perception_Academy_Quest.mp4
public/assets/ela-quests/QUEST-Video_Poe-short.mp4
public/assets/menlomath/MenloMath_walkthru.m4v
public/assets/odell-education/Stylescapes_OE_Stylescape_05_Animation.m4v
public/assets/tmobile/Journey-animation.mp4
public/assets/unbound/UnboundUX8.mp4
public/assets/xq-canvas/XQ_CANVAS.mp4
public/assets/xq-directory/XQ_DIRECTORY.mp4

# Uploaded masters for the Interactive recordings. The site ships the derived
# thumb.jpg / still.jpg / preview.mp4 next to them, never these.
public/assets/*/masters

# Pitch material (job descriptions of companies applied to) stays out of the
# deploy. The sample postings the Studio and the tests use live in
# src/analyze/samples, outside this folder, so no negation pattern is needed
# (a build that could not find the sample failed on Vercel).
/src/pitches
