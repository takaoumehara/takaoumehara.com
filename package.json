{
  "name": "takaoumehara.com",
  "private": true,
  "type": "module",
  "description": "Adaptive career portfolio — one evidence base, rendered through lenses. Built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "pitch": "node scripts/generate-pitch.mjs",
    "audit": "node scripts/audit-evidence.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/vercel": "^11.0.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "astro": "^7.3.3"
  }
}
